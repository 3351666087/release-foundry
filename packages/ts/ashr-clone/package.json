{
  "name": "@ashr-clone/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only TypeScript parity SDK for Ashr clone A1 runtime.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account-connections": {
      "types": "./dist/account-connections.d.ts",
      "import": "./dist/account-connections.js"
    },
    "./account-readiness": {
      "types": "./dist/account-readiness.d.ts",
      "import": "./dist/account-readiness.js"
    },
    "./api-client": {
      "types": "./dist/api-client.d.ts",
      "import": "./dist/api-client.js"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "import": "./dist/billing.js"
    },
    "./browser-session": {
      "types": "./dist/browser-session.d.ts",
      "import": "./dist/browser-session.js"
    },
    "./calibrate": {
      "types": "./dist/calibrate.d.ts",
      "import": "./dist/calibrate.js"
    },
    "./capability-matrix": {
      "types": "./dist/capability-matrix.d.ts",
      "import": "./dist/capability-matrix.js"
    },
    "./china-payments": {
      "types": "./dist/china-payments.d.ts",
      "import": "./dist/china-payments.js"
    },
    "./cloud-queue": {
      "types": "./dist/cloud-queue.d.ts",
      "import": "./dist/cloud-queue.js"
    },
    "./commercial": {
      "types": "./dist/commercial.d.ts",
      "import": "./dist/commercial.js"
    },
    "./dataset-adapter": {
      "types": "./dist/dataset-adapter.d.ts",
      "import": "./dist/dataset-adapter.js"
    },
    "./delivery-protocol": {
      "types": "./dist/delivery-protocol.d.ts",
      "import": "./dist/delivery-protocol.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js"
    },
    "./github-oauth": {
      "types": "./dist/github-oauth.d.ts",
      "import": "./dist/github-oauth.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./python-parity": {
      "types": "./dist/python-parity.d.ts",
      "import": "./dist/python-parity.js"
    },
    "./provider-adapter": {
      "types": "./dist/provider-adapter.d.ts",
      "import": "./dist/provider-adapter.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    },
    "./saas": {
      "types": "./dist/saas.d.ts",
      "import": "./dist/saas.js"
    },
    "./session-lifecycle": {
      "types": "./dist/session-lifecycle.d.ts",
      "import": "./dist/session-lifecycle.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./stripe-executor": {
      "types": "./dist/stripe-executor.d.ts",
      "import": "./dist/stripe-executor.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js"
    },
    "./unified-identity": {
      "types": "./dist/unified-identity.d.ts",
      "import": "./dist/unified-identity.js"
    }
  },
  "bin": {
    "ashr-clone-browser-session": "./dist/browser-session-cli.js",
    "ashr-clone-account-readiness": "./dist/account-readiness-cli.js",
    "ashr-clone-account-connections": "./dist/account-connections-cli.js",
    "ashr-clone-api-probe": "./dist/probe.js",
    "ashr-clone-calibrate": "./dist/calibrate.js",
    "ashr-clone-cloud": "./dist/cloud-cli.js",
    "ashr-clone-dataset-adapter": "./dist/dataset-adapter-cli.js",
    "ashr-clone-github-oauth": "./dist/github-oauth-cli.js",
    "ashr-clone-probe": "./dist/probe.js",
    "ashr-clone-runner": "./dist/runner-cli.js",
    "ashr-clone-saas": "./dist/saas.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "cloud": "node dist/cloud-cli.js",
    "probe": "node dist/probe.js",
    "runner": "node dist/runner-cli.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  }
}

ARG POSTGRES_MIGRATION_IMAGE=postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777

FROM ${POSTGRES_MIGRATION_IMAGE}

ARG VCS_REF=unknown
ARG VCS_TREE=unknown
ARG SOURCE_REPOSITORY=https://github.com/3351666087/ashr-codex-factory
LABEL org.opencontainers.image.source=$SOURCE_REPOSITORY \
      org.opencontainers.image.revision=$VCS_REF \
      io.ashr.source.tree=$VCS_TREE

COPY infra/docker/postgres-migrate.sh /opt/ashr/postgres-migrate.sh
COPY docs/a1/schemas/a1_control_plane_postgres_migration.sql /migrations/a1_control_plane_postgres_migration.sql
COPY services/api/migrations/*.sql /migrations/ordered/
RUN chmod 0555 /opt/ashr/postgres-migrate.sh \
 && chmod 0444 /migrations/a1_control_plane_postgres_migration.sql /migrations/ordered/*.sql

ENTRYPOINT ["/bin/sh", "/opt/ashr/postgres-migrate.sh"]

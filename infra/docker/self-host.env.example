# A1 commercial self-host runtime example.
# Values here are local placeholders or references only. Do not commit real keys.

ASHR_RUNTIME_ENV=self-host
ASHR_SECRET_PROVIDER=env-ref

# Reference names consumed by the runtime. Production deployments should resolve
# these names through the deployment secret manager, not from this file.
ASHR_DATABASE_URL_REF=env:ASHR_DATABASE_URL
ASHR_POSTGRES_DSN_REF=env:ASHR_DATABASE_URL
ASHR_REDIS_URL_REF=env:ASHR_REDIS_URL
ASHR_OBJECT_STORE_ENDPOINT_REF=env:ASHR_OBJECT_STORE_ENDPOINT
ASHR_OBJECT_STORE_ACCESS_KEY_REF=env:ASHR_OBJECT_STORE_ACCESS_KEY
ASHR_OBJECT_STORE_SECRET_KEY_REF=env:ASHR_OBJECT_STORE_SECRET_KEY
ASHR_BILLING_PROVIDER_SECRET_REF=env:ASHR_BILLING_PROVIDER_SECRET
ASHR_BILLING_WEBHOOK_SECRET_REF=env:ASHR_BILLING_WEBHOOK_SECRET

# China payment provider references. Values are resolved only by a deployment
# secret manager; workers receive these names, not provider credentials.
ASHR_WECHAT_PAY_MERCHANT_ID_REF=env:ASHR_WECHAT_PAY_MERCHANT_ID
ASHR_WECHAT_PAY_API_V3_KEY_REF=env:ASHR_WECHAT_PAY_API_V3_KEY
ASHR_WECHAT_PAY_MERCHANT_PRIVATE_KEY_REF=env:ASHR_WECHAT_PAY_MERCHANT_PRIVATE_KEY
ASHR_WECHAT_PAY_PLATFORM_CERT_REF=env:ASHR_WECHAT_PAY_PLATFORM_CERT
ASHR_ALIPAY_APP_ID_REF=env:ASHR_ALIPAY_APP_ID
ASHR_ALIPAY_APP_PRIVATE_KEY_REF=env:ASHR_ALIPAY_APP_PRIVATE_KEY
ASHR_ALIPAY_PUBLIC_KEY_REF=env:ASHR_ALIPAY_PUBLIC_KEY
ASHR_CHINA_ACQUIRER_MERCHANT_ID_REF=env:ASHR_CHINA_ACQUIRER_MERCHANT_ID
ASHR_CHINA_ACQUIRER_HOSTED_ORIGIN_REF=env:ASHR_CHINA_ACQUIRER_HOSTED_ORIGIN
ASHR_CHINA_ACQUIRER_SESSION_TOKEN_REF=env:ASHR_CHINA_ACQUIRER_SESSION_TOKEN
ASHR_CHINA_ACQUIRER_SIGNING_KEY_REF=env:ASHR_CHINA_ACQUIRER_SIGNING_KEY
ASHR_CHINA_ACQUIRER_MODE=hosted-token-reference-only

# Provider egress is disabled in this scaffold. Stripe remains an optional
# compatibility surface and is disabled unless an operator explicitly enables it.
ASHR_CHINA_PAYMENT_PROVIDER_NETWORK_ENABLED=false
ASHR_STRIPE_ENABLED=false
ASHR_STRIPE_ACCOUNT_ID_REF=env:ASHR_STRIPE_ACCOUNT_ID
ASHR_STRIPE_SECRET_KEY_REF=env:ASHR_STRIPE_SECRET_KEY
ASHR_STRIPE_WEBHOOK_SECRET_REF=env:ASHR_STRIPE_WEBHOOK_SECRET
ASHR_STRIPE_CHECKOUT_MODE=hosted-checkout-reference-only

# Local non-secret endpoints for docker compose profile smoke runs.
ASHR_DATABASE_URL=postgresql://ashr:${ASHR_POSTGRES_AUTH_SECRET}@postgres:5432/ashr?sslmode=disable
ASHR_REDIS_URL=redis://redis:6379/0
ASHR_OBJECT_STORE_ENDPOINT=http://minio:9000
ASHR_OBJECT_STORE_BUCKET=ashr-local-artifacts
ASHR_OBJECT_EVIDENCE_PREFIX=evidence/a1/self-host
ASHR_PAYMENT_EVIDENCE_HASH_PREFIX=evidence/a1/self-host/china-payments/sha256

ASHR_QUOTA_LEDGER_TABLE=ashr_quota_ledger
ASHR_ARTIFACT_MANIFEST_TABLE=ashr_artifact_manifests
ASHR_WORKER_JOBS_TABLE=ashr_worker_jobs

ASHR_WORKER_MODE=daemon
ASHR_WORKER_QUEUE=ashr_worker_jobs
ASHR_WORKER_LEASE_SECONDS=300
ASHR_WORKER_POLL_INTERVAL_SECONDS=30
ASHR_WORKER_MAX_ATTEMPTS=3
ASHR_WORKER_EVIDENCE_WRITES=object-store
ASHR_WORKER_HEARTBEAT_INTERVAL=30s
ASHR_WORKER_RESTART_DELAY_SECONDS=5

# Dedicated China payment lanes. The durable worker table remains shared, but
# leasing is isolated by job_type and each lane has its own dead-letter policy.
ASHR_CHINA_PAYMENT_WEBHOOK_QUEUE=china_payment_webhook_ingestion
ASHR_CHINA_PAYMENT_WEBHOOK_MAX_ATTEMPTS=5
ASHR_CHINA_PAYMENT_WEBHOOK_RETRY_DELAYS_SECONDS=5,30,120,600
ASHR_CHINA_PAYMENT_WEBHOOK_DEAD_LETTER_QUEUE=china_payment_webhook_dead_letter
ASHR_CHINA_PAYMENT_RECONCILIATION_QUEUE=china_payment_bill_reconciliation
ASHR_CHINA_PAYMENT_RECONCILIATION_MAX_ATTEMPTS=4
ASHR_CHINA_PAYMENT_RECONCILIATION_RETRY_DELAYS_SECONDS=300,1800,7200
ASHR_CHINA_PAYMENT_RECONCILIATION_DEAD_LETTER_QUEUE=china_payment_reconciliation_dead_letter
ASHR_CHINA_BANK_ACQUIRER_QUEUE=china_bank_acquirer_events
ASHR_CHINA_BANK_ACQUIRER_MAX_ATTEMPTS=5
ASHR_CHINA_BANK_ACQUIRER_RETRY_DELAYS_SECONDS=10,60,300,1800
ASHR_CHINA_BANK_ACQUIRER_DEAD_LETTER_QUEUE=china_bank_acquirer_dead_letter
ASHR_PAYMENT_RECONCILIATION_SCHEDULE_UTC=02:15
ASHR_PAYMENT_RECONCILIATION_RUN_ON_START=false

# Stripe branch is retained for compatibility but has a separate opt-in
# `stripe-payments` Compose profile and remains disabled by default.
ASHR_STRIPE_PAYMENT_QUEUE=stripe_payment_events
ASHR_STRIPE_PAYMENT_MAX_ATTEMPTS=5
ASHR_STRIPE_PAYMENT_RETRY_DELAYS_SECONDS=10,60,300,1800
ASHR_STRIPE_PAYMENT_DEAD_LETTER_QUEUE=stripe_payment_dead_letter

# The live commercial smoke is opt-in:
# ASHR_RUN_COMMERCIAL_COMPOSE_SMOKE=1 python -m pytest tests/a1/test_round45_commercial_compose.py -m docker -q
# Export the three secret values below in the invoking shell. The tracked
# example intentionally contains reference names only and cannot start the
# commercial profile by itself.

# Local compose secrets may be exported by the operator before startup, or
# supplied by a real secret manager in production. Keep real values untracked.
ASHR_OBJECT_STORE_ACCESS_KEY_REF_ONLY=env:ASHR_OBJECT_STORE_ACCESS_KEY
ASHR_OBJECT_STORE_SECRET_KEY_REF_ONLY=env:ASHR_OBJECT_STORE_SECRET_KEY

ASHR_POSTGRES_AUTH_SECRET_REF=env:ASHR_POSTGRES_AUTH_SECRET

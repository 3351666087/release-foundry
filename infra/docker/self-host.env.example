# A1 commercial self-host runtime example.
# Values here are local placeholders or references only. Do not commit real keys.

ASHR_RUNTIME_ENV=self-host
ASHR_SECRET_PROVIDER=env-ref

# Reference names consumed by the runtime. Production deployments should resolve
# these names through the deployment secret manager, not from this file.
ASHR_DATABASE_URL_REF=env:ASHR_DATABASE_URL
ASHR_POSTGRES_DSN_REF=env:ASHR_DATABASE_URL
ASHR_REDIS_URL_REF=env:ASHR_REDIS_URL
ASHR_OBJECT_STORE_ENDPOINT_REF=env:ASHR_OBJECT_STORE_ENDPOINT
ASHR_OBJECT_STORE_ACCESS_KEY_REF=env:ASHR_OBJECT_STORE_ACCESS_KEY
ASHR_OBJECT_STORE_SECRET_KEY_REF=env:ASHR_OBJECT_STORE_SECRET_KEY
ASHR_BILLING_PROVIDER_SECRET_REF=env:ASHR_BILLING_PROVIDER_SECRET
ASHR_BILLING_WEBHOOK_SECRET_REF=env:ASHR_BILLING_WEBHOOK_SECRET

# Local non-secret endpoints for docker compose profile smoke runs.
ASHR_DATABASE_URL=postgresql://ashr@postgres:5432/ashr?sslmode=disable
ASHR_REDIS_URL=redis://redis:6379/0
ASHR_OBJECT_STORE_ENDPOINT=http://minio:9000
ASHR_OBJECT_STORE_BUCKET=ashr-local-artifacts
ASHR_OBJECT_EVIDENCE_PREFIX=evidence/a1/self-host

ASHR_QUOTA_LEDGER_TABLE=ashr_quota_ledger
ASHR_ARTIFACT_MANIFEST_TABLE=ashr_artifact_manifests
ASHR_WORKER_JOBS_TABLE=ashr_worker_jobs

ASHR_WORKER_MODE=daemon
ASHR_WORKER_QUEUE=ashr_worker_jobs
ASHR_WORKER_LEASE_SECONDS=300
ASHR_WORKER_POLL_INTERVAL_SECONDS=30
ASHR_WORKER_MAX_ATTEMPTS=3
ASHR_WORKER_EVIDENCE_WRITES=object-store

# Local compose secrets may be exported by the operator before startup, or
# supplied by a real secret manager in production. Keep real values untracked.
ASHR_OBJECT_STORE_ACCESS_KEY_REF_ONLY=env:ASHR_OBJECT_STORE_ACCESS_KEY
ASHR_OBJECT_STORE_SECRET_KEY_REF_ONLY=env:ASHR_OBJECT_STORE_SECRET_KEY

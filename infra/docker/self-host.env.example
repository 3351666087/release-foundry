# A1 commercial self-host runtime example.
# Values here are local placeholders or references only. Do not commit real keys.

RELEASEFOUNDRY_RUNTIME_ENV=self-host
RELEASEFOUNDRY_SECRET_PROVIDER=env-ref
RELEASEFOUNDRY_ENVIRONMENT=self-host
RELEASEFOUNDRY_IDENTITY_RUNTIME=postgres
RELEASEFOUNDRY_IDENTITY_SESSION_HMAC_ACTIVE_VERSION=v1
RELEASEFOUNDRY_IDENTITY_SESSION_HMAC_LEGACY_VERSION=v1
RELEASEFOUNDRY_IDENTITY_SESSION_HMAC_KEY_REF=env:RELEASEFOUNDRY_IDENTITY_SESSION_HMAC_KEY
RELEASEFOUNDRY_IDENTITY_LIFECYCLE_RECEIPT_ACTIVE_VERSION=v1
RELEASEFOUNDRY_IDENTITY_LIFECYCLE_RECEIPT_KEY_REF=env:RELEASEFOUNDRY_IDENTITY_LIFECYCLE_RECEIPT_KEY

# Reference names consumed by the runtime. Production deployments should resolve
# these names through the deployment secret manager, not from this file.
RELEASEFOUNDRY_DATABASE_URL_REF=env:RELEASEFOUNDRY_DATABASE_URL
RELEASEFOUNDRY_POSTGRES_DSN_REF=env:RELEASEFOUNDRY_DATABASE_URL
RELEASEFOUNDRY_IDENTITY_POSTGRES_DSN_REF=env:RELEASEFOUNDRY_IDENTITY_POSTGRES_DSN
RELEASEFOUNDRY_REDIS_URL_REF=env:RELEASEFOUNDRY_REDIS_URL
RELEASEFOUNDRY_OBJECT_STORE_ENDPOINT_REF=env:RELEASEFOUNDRY_OBJECT_STORE_ENDPOINT
RELEASEFOUNDRY_OBJECT_STORE_ACCESS_KEY_REF=env:RELEASEFOUNDRY_OBJECT_STORE_ACCESS_KEY
RELEASEFOUNDRY_OBJECT_STORE_SECRET_KEY_REF=env:RELEASEFOUNDRY_OBJECT_STORE_SECRET_KEY
RELEASEFOUNDRY_BILLING_PROVIDER_SECRET_REF=env:RELEASEFOUNDRY_BILLING_PROVIDER_SECRET
RELEASEFOUNDRY_BILLING_WEBHOOK_SECRET_REF=env:RELEASEFOUNDRY_BILLING_WEBHOOK_SECRET

# China payment provider references. Values are resolved only by a deployment
# secret manager; workers receive these names, not provider credentials.
RELEASEFOUNDRY_WECHAT_PAY_MERCHANT_ID_REF=env:RELEASEFOUNDRY_WECHAT_PAY_MERCHANT_ID
RELEASEFOUNDRY_WECHAT_PAY_API_V3_KEY_REF=env:RELEASEFOUNDRY_WECHAT_PAY_API_V3_KEY
RELEASEFOUNDRY_WECHAT_PAY_MERCHANT_PRIVATE_KEY_REF=env:RELEASEFOUNDRY_WECHAT_PAY_MERCHANT_PRIVATE_KEY
RELEASEFOUNDRY_WECHAT_PAY_PLATFORM_CERT_REF=env:RELEASEFOUNDRY_WECHAT_PAY_PLATFORM_CERT
RELEASEFOUNDRY_ALIPAY_APP_ID_REF=env:RELEASEFOUNDRY_ALIPAY_APP_ID
RELEASEFOUNDRY_ALIPAY_APP_PRIVATE_KEY_REF=env:RELEASEFOUNDRY_ALIPAY_APP_PRIVATE_KEY
RELEASEFOUNDRY_ALIPAY_PUBLIC_KEY_REF=env:RELEASEFOUNDRY_ALIPAY_PUBLIC_KEY
RELEASEFOUNDRY_CHINA_ACQUIRER_MERCHANT_ID_REF=env:RELEASEFOUNDRY_CHINA_ACQUIRER_MERCHANT_ID
RELEASEFOUNDRY_CHINA_ACQUIRER_HOSTED_ORIGIN_REF=env:RELEASEFOUNDRY_CHINA_ACQUIRER_HOSTED_ORIGIN
RELEASEFOUNDRY_CHINA_ACQUIRER_SESSION_TOKEN_REF=env:RELEASEFOUNDRY_CHINA_ACQUIRER_SESSION_TOKEN
RELEASEFOUNDRY_CHINA_ACQUIRER_SIGNING_KEY_REF=env:RELEASEFOUNDRY_CHINA_ACQUIRER_SIGNING_KEY
RELEASEFOUNDRY_CHINA_ACQUIRER_MODE=hosted-token-reference-only

# Provider egress is disabled in this scaffold. Stripe remains an optional
# compatibility surface and is disabled unless an operator explicitly enables it.
RELEASEFOUNDRY_CHINA_PAYMENT_PROVIDER_NETWORK_ENABLED=false
RELEASEFOUNDRY_STRIPE_ENABLED=false
RELEASEFOUNDRY_STRIPE_ACCOUNT_ID_REF=env:RELEASEFOUNDRY_STRIPE_ACCOUNT_ID
RELEASEFOUNDRY_STRIPE_SECRET_KEY_REF=env:RELEASEFOUNDRY_STRIPE_SECRET_KEY
RELEASEFOUNDRY_STRIPE_WEBHOOK_SECRET_REF=env:RELEASEFOUNDRY_STRIPE_WEBHOOK_SECRET
RELEASEFOUNDRY_STRIPE_CHECKOUT_MODE=hosted-checkout-reference-only

# Local non-secret endpoints for docker compose profile smoke runs.
RELEASEFOUNDRY_DATABASE_URL=postgresql://releasefoundry:${RELEASEFOUNDRY_POSTGRES_AUTH_SECRET}@postgres:5432/releasefoundry?sslmode=disable
RELEASEFOUNDRY_IDENTITY_POSTGRES_DSN=postgresql://releasefoundry_identity_runtime:${RELEASEFOUNDRY_POSTGRES_RUNTIME_SECRET}@postgres:5432/releasefoundry?sslmode=disable
RELEASEFOUNDRY_REDIS_URL=redis://redis:6379/0
RELEASEFOUNDRY_OBJECT_STORE_ENDPOINT=http://minio:9000
RELEASEFOUNDRY_OBJECT_STORE_BUCKET=releasefoundry-local-artifacts
RELEASEFOUNDRY_OBJECT_EVIDENCE_PREFIX=evidence/a1/self-host
RELEASEFOUNDRY_PAYMENT_EVIDENCE_HASH_PREFIX=evidence/a1/self-host/china-payments/sha256

RELEASEFOUNDRY_QUOTA_LEDGER_TABLE=releasefoundry_quota_ledger
RELEASEFOUNDRY_ARTIFACT_MANIFEST_TABLE=releasefoundry_artifact_manifests
RELEASEFOUNDRY_WORKER_JOBS_TABLE=releasefoundry_worker_jobs

RELEASEFOUNDRY_WORKER_MODE=daemon
RELEASEFOUNDRY_WORKER_QUEUE=releasefoundry_worker_jobs
RELEASEFOUNDRY_WORKER_LEASE_SECONDS=300
RELEASEFOUNDRY_WORKER_POLL_INTERVAL_SECONDS=30
RELEASEFOUNDRY_WORKER_MAX_ATTEMPTS=3
RELEASEFOUNDRY_WORKER_EVIDENCE_WRITES=object-store
RELEASEFOUNDRY_WORKER_HEARTBEAT_INTERVAL=30s
RELEASEFOUNDRY_WORKER_RESTART_DELAY_SECONDS=5

# Dedicated China payment lanes. The durable worker table remains shared, but
# leasing is isolated by job_type and each lane has its own dead-letter policy.
RELEASEFOUNDRY_CHINA_PAYMENT_WEBHOOK_QUEUE=china_payment_webhook_ingestion
RELEASEFOUNDRY_CHINA_PAYMENT_WEBHOOK_MAX_ATTEMPTS=5
RELEASEFOUNDRY_CHINA_PAYMENT_WEBHOOK_RETRY_DELAYS_SECONDS=5,30,120,600
RELEASEFOUNDRY_CHINA_PAYMENT_WEBHOOK_DEAD_LETTER_QUEUE=china_payment_webhook_dead_letter
RELEASEFOUNDRY_CHINA_PAYMENT_RECONCILIATION_QUEUE=china_payment_bill_reconciliation
RELEASEFOUNDRY_CHINA_PAYMENT_RECONCILIATION_MAX_ATTEMPTS=4
RELEASEFOUNDRY_CHINA_PAYMENT_RECONCILIATION_RETRY_DELAYS_SECONDS=300,1800,7200
RELEASEFOUNDRY_CHINA_PAYMENT_RECONCILIATION_DEAD_LETTER_QUEUE=china_payment_reconciliation_dead_letter
RELEASEFOUNDRY_CHINA_BANK_ACQUIRER_QUEUE=china_bank_acquirer_events
RELEASEFOUNDRY_CHINA_BANK_ACQUIRER_MAX_ATTEMPTS=5
RELEASEFOUNDRY_CHINA_BANK_ACQUIRER_RETRY_DELAYS_SECONDS=10,60,300,1800
RELEASEFOUNDRY_CHINA_BANK_ACQUIRER_DEAD_LETTER_QUEUE=china_bank_acquirer_dead_letter
RELEASEFOUNDRY_PAYMENT_RECONCILIATION_SCHEDULE_UTC=02:15
RELEASEFOUNDRY_PAYMENT_RECONCILIATION_RUN_ON_START=false

# Stripe branch is retained for compatibility but has a separate opt-in
# `stripe-payments` Compose profile and remains disabled by default.
RELEASEFOUNDRY_STRIPE_PAYMENT_QUEUE=stripe_payment_events
RELEASEFOUNDRY_STRIPE_PAYMENT_MAX_ATTEMPTS=5
RELEASEFOUNDRY_STRIPE_PAYMENT_RETRY_DELAYS_SECONDS=10,60,300,1800
RELEASEFOUNDRY_STRIPE_PAYMENT_DEAD_LETTER_QUEUE=stripe_payment_dead_letter

# The live commercial smoke is opt-in:
# RELEASEFOUNDRY_RUN_COMMERCIAL_COMPOSE_SMOKE=1 python -m pytest tests/a1/test_round45_commercial_compose.py -m docker -q
# The three secret values below may be exported in the invoking shell, or be
# placed in the private env file used by the installer. The shell values take
# precedence and are never written back to this tracked example.

# Local compose secrets may be exported by the operator before startup, or
# supplied by a real secret manager in production. Keep real values untracked.
RELEASEFOUNDRY_OBJECT_STORE_ACCESS_KEY_REF_ONLY=env:RELEASEFOUNDRY_OBJECT_STORE_ACCESS_KEY
RELEASEFOUNDRY_OBJECT_STORE_SECRET_KEY_REF_ONLY=env:RELEASEFOUNDRY_OBJECT_STORE_SECRET_KEY

RELEASEFOUNDRY_POSTGRES_AUTH_SECRET_REF=env:RELEASEFOUNDRY_POSTGRES_AUTH_SECRET
RELEASEFOUNDRY_POSTGRES_RUNTIME_SECRET_REF=env:RELEASEFOUNDRY_POSTGRES_RUNTIME_SECRET

# The two HMAC values above are references only. Supply the corresponding
# RELEASEFOUNDRY_IDENTITY_SESSION_HMAC_KEY and RELEASEFOUNDRY_IDENTITY_LIFECYCLE_RECEIPT_KEY from
# the private environment file or deployment secret manager before startup.

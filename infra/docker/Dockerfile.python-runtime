FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RELEASEFOUNDRY_RUNTIME_ENV=self-host

WORKDIR /app

COPY . /app

RUN python -m compileall -q services packages tests/integration

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python - <<'PY'
from services.api.control_plane import SaaSControlPlaneService
service = SaaSControlPlaneService()
assert service.health()['status'] == 'ok'
PY

CMD ["python", "-c", "from services.api.control_plane import serve_control_plane_http; server = serve_control_plane_http('0.0.0.0', 8080); server.serve_forever()"]

ARG GO_BUILD_IMAGE=golang:1.22-bookworm@sha256:3d699e4d15d0f8f13c9195c0632a16702b8cbdece2955af1c23b37ae5d55a253
ARG DEBIAN_RUNTIME_IMAGE=debian:bookworm-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df

FROM ${GO_BUILD_IMAGE} AS build

ENV CGO_ENABLED=0
WORKDIR /src/packages/go/releasefoundry
COPY . /src
RUN go test ./...
RUN go build -trimpath -ldflags="-s -w -buildid=" -o /out/releasefoundry-api ./cmd/releasefoundry-api \
 && go build -trimpath -ldflags="-s -w -buildid=" -o /out/releasefoundry-worker ./cmd/releasefoundry-worker \
 && go build -trimpath -ldflags="-s -w -buildid=" -o /out/releasefoundry-identity-delivery ./cmd/releasefoundry-identity-delivery \
 && go build -trimpath -ldflags="-s -w -buildid=" -o /out/releasefoundry-healthcheck /src/services/runner/a1_docker_healthcheck.go

FROM ${DEBIAN_RUNTIME_IMAGE} AS runtime

ARG VCS_REF=unknown
ARG VCS_TREE=unknown
ARG SOURCE_REPOSITORY=https://github.com/3351666087/release-foundry
LABEL org.opencontainers.image.source=$SOURCE_REPOSITORY \
      org.opencontainers.image.revision=$VCS_REF \
      io.releasefoundry.source.tree=$VCS_TREE

ENV RELEASEFOUNDRY_RUNTIME_ENV=self-host
WORKDIR /app
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates findutils \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /runtime/worker /runtime/payment-webhook /runtime/payment-reconciliation \
      /runtime/china-bank-acquirer /runtime/stripe-payment /tmp \
 && chown -R 65532:65532 /runtime /tmp
COPY --from=build /out/releasefoundry-api /out/releasefoundry-worker /out/releasefoundry-identity-delivery /out/releasefoundry-healthcheck /usr/local/bin/
COPY services/runner/*.sh /app/services/runner/
RUN chmod 0555 /usr/local/bin/releasefoundry-api /usr/local/bin/releasefoundry-worker \
      /usr/local/bin/releasefoundry-identity-delivery /usr/local/bin/releasefoundry-healthcheck \
      /app/services/runner/*.sh

USER 65532:65532
EXPOSE 8787 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD /usr/local/bin/releasefoundry-healthcheck http://127.0.0.1:8787/healthz postgres_repository_v0
CMD ["/usr/local/bin/releasefoundry-api"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2MultimodalRealApiSmoke",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "sdk_source",
    "base_url",
    "auth",
    "private_ref",
    "private_ref_sha256_12",
    "accepted_modalities",
    "generation_options",
    "api_call_count",
    "calls",
    "request_id_present",
    "request_id_sha256_12",
    "request_status",
    "dataset_id_present",
    "dataset_id_sha256_12",
    "dataset_summary",
    "all_required_modalities_requested",
    "create_request_reached",
    "wait_completed",
    "public_safe",
    "c3_grading_ready",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "a2.multimodal_real_api_smoke.v1" },
    "generated_at": { "type": "string" },
    "sdk_source": { "type": "string" },
    "base_url": { "type": "string" },
    "auth": {
      "type": "object",
      "required": [
        "session_reached",
        "status",
        "user_id_present",
        "user_email_sha256_12",
        "tenant_id_present",
        "tenant_name_present",
        "note_count"
      ],
      "properties": {
        "session_reached": { "type": "boolean" },
        "status": { "type": "string" },
        "user_id_present": { "type": "boolean" },
        "user_email_sha256_12": { "type": "string" },
        "tenant_id_present": { "type": "boolean" },
        "tenant_name_present": { "type": "boolean" },
        "note_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "private_ref": { "type": "string" },
    "private_ref_sha256_12": { "type": "string" },
    "accepted_modalities": {
      "type": "array",
      "items": { "enum": ["text", "image", "audio", "file", "video"] }
    },
    "generation_options": {
      "type": "object",
      "required": ["generate_audio", "generate_files", "generate_images", "generate_videos"],
      "properties": {
        "generate_audio": { "type": "boolean" },
        "generate_files": { "type": "boolean" },
        "generate_images": { "type": "boolean" },
        "generate_videos": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "api_call_count": { "type": "integer", "minimum": 0 },
    "calls": {
      "type": "array",
      "items": { "$ref": "#/$defs/call" }
    },
    "request_id_present": { "type": "boolean" },
    "request_id_sha256_12": { "type": "string" },
    "request_status": { "type": "string" },
    "dataset_id_present": { "type": "boolean" },
    "dataset_id_sha256_12": { "type": "string" },
    "dataset_summary": { "type": "object" },
    "all_required_modalities_requested": { "type": "boolean" },
    "create_request_reached": { "type": "boolean" },
    "wait_completed": { "type": "boolean" },
    "public_safe": { "type": "boolean" },
    "c3_grading_ready": { "type": "boolean" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "call": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {
          "enum": [
            "init",
            "create_request",
            "wait_for_request",
            "get_request",
            "list_datasets",
            "get_dataset"
          ]
        },
        "status": { "enum": ["ok", "error"] },
        "summary": { "type": "object" },
        "error_type": { "type": "string" },
        "error_message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2 CoverageReport",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "assignment_minimums",
    "assignment_checks",
    "meets_assignment_minimums",
    "calibration_redundancy_targets",
    "scenario_dimension_minimums",
    "scenario_dimension_checks",
    "capability_axis_targets",
    "capability_axis_dimension_map",
    "capability_axis_checks",
    "scenario_quality_targets",
    "scenario_quality_warnings",
    "scenario_count",
    "family_counts",
    "difficulty_counts",
    "action_count_counts",
    "multi_turn_scenario_count",
    "environment_counts",
    "tag_counts",
    "scenario_dimension_counts",
    "scenario_dimension_scenarios",
    "thin_scenario_dimensions",
    "capability_axis_counts",
    "capability_axis_scenarios",
    "missing_capability_axes",
    "tool_policy_shape_counts",
    "required_tool_counts",
    "optional_tool_counts",
    "forbidden_tool_counts",
    "ordered_tool_count",
    "ordered_tool_pairs",
    "rubric_classes",
    "primary_rubric_counts",
    "judge_modes",
    "primary_failure_class_counts",
    "failure_signal_count",
    "failure_signals",
    "required_failure_classes_covered",
    "required_failure_classes_missing",
    "golden_case_count",
    "golden_pass_case_count",
    "golden_failure_case_count",
    "golden_failure_class_counts",
    "golden_failure_class_cases",
    "golden_failure_classes_missing",
    "thin_golden_failure_classes",
    "executable_run_case_count",
    "executable_failure_case_count",
    "executable_failure_class_counts",
    "executable_failure_class_cases",
    "executable_failure_classes_missing",
    "thin_executable_failure_classes",
    "executable_media_case_count",
    "executable_tool_output_grounding_case_count",
    "executable_media_expected_class_counts",
    "executable_media_case_refs",
    "executable_tool_output_grounding_case_refs",
    "coverage_warnings",
    "fixture_ref_count",
    "fixture_scenario_count",
    "fixture_type_counts",
    "fixture_ref_counts_by_scenario"
  ],
  "properties": {
    "schema_version": { "const": "a2.coverage_report.v1" },
    "pack_id": { "type": "string" },
    "assignment_minimums": { "$ref": "#/$defs/count_map" },
    "assignment_checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "meets_assignment_minimums": { "type": "boolean" },
    "calibration_redundancy_targets": { "$ref": "#/$defs/count_map" },
    "scenario_dimension_minimums": { "$ref": "#/$defs/count_map" },
    "scenario_dimension_checks": { "$ref": "#/$defs/boolean_map" },
    "capability_axis_targets": { "$ref": "#/$defs/count_map" },
    "capability_axis_dimension_map": { "$ref": "#/$defs/string_array_map" },
    "capability_axis_checks": { "$ref": "#/$defs/boolean_map" },
    "scenario_quality_targets": { "$ref": "#/$defs/count_map" },
    "scenario_quality_warnings": { "$ref": "#/$defs/string_array" },
    "scenario_count": { "type": "integer", "minimum": 0 },
    "family_counts": { "$ref": "#/$defs/count_map" },
    "difficulty_counts": { "$ref": "#/$defs/count_map" },
    "action_count_counts": { "$ref": "#/$defs/count_map" },
    "multi_turn_scenario_count": { "type": "integer", "minimum": 0 },
    "environment_counts": { "$ref": "#/$defs/count_map" },
    "tag_counts": { "$ref": "#/$defs/count_map" },
    "scenario_dimension_counts": { "$ref": "#/$defs/count_map" },
    "scenario_dimension_scenarios": { "$ref": "#/$defs/string_array_map" },
    "thin_scenario_dimensions": { "$ref": "#/$defs/count_map" },
    "capability_axis_counts": { "$ref": "#/$defs/count_map" },
    "capability_axis_scenarios": { "$ref": "#/$defs/string_array_map" },
    "missing_capability_axes": { "$ref": "#/$defs/string_array" },
    "tool_policy_shape_counts": { "$ref": "#/$defs/count_map" },
    "required_tool_counts": { "$ref": "#/$defs/count_map" },
    "optional_tool_counts": { "$ref": "#/$defs/count_map" },
    "forbidden_tool_counts": { "$ref": "#/$defs/count_map" },
    "ordered_tool_count": { "type": "integer", "minimum": 0 },
    "ordered_tool_pairs": { "$ref": "#/$defs/count_map" },
    "rubric_classes": { "$ref": "#/$defs/string_array" },
    "primary_rubric_counts": { "$ref": "#/$defs/count_map" },
    "judge_modes": { "$ref": "#/$defs/string_array" },
    "primary_failure_class_counts": { "$ref": "#/$defs/count_map" },
    "failure_signal_count": { "type": "integer", "minimum": 0 },
    "failure_signals": { "$ref": "#/$defs/string_array" },
    "required_failure_classes_covered": { "$ref": "#/$defs/string_array" },
    "required_failure_classes_missing": { "$ref": "#/$defs/string_array" },
    "golden_case_count": { "type": "integer", "minimum": 0 },
    "golden_pass_case_count": { "type": "integer", "minimum": 0 },
    "golden_failure_case_count": { "type": "integer", "minimum": 0 },
    "golden_failure_class_counts": { "$ref": "#/$defs/count_map" },
    "golden_failure_class_cases": { "$ref": "#/$defs/failure_case_ref_map" },
    "golden_failure_classes_missing": { "$ref": "#/$defs/string_array" },
    "thin_golden_failure_classes": { "$ref": "#/$defs/count_map" },
    "executable_run_case_count": { "type": "integer", "minimum": 0 },
    "executable_failure_case_count": { "type": "integer", "minimum": 0 },
    "executable_failure_class_counts": { "$ref": "#/$defs/count_map" },
    "executable_failure_class_cases": { "$ref": "#/$defs/failure_case_ref_map" },
    "executable_failure_classes_missing": { "$ref": "#/$defs/string_array" },
    "thin_executable_failure_classes": { "$ref": "#/$defs/count_map" },
    "executable_media_case_count": { "type": "integer", "minimum": 0 },
    "executable_tool_output_grounding_case_count": { "type": "integer", "minimum": 0 },
    "executable_media_expected_class_counts": { "$ref": "#/$defs/count_map" },
    "executable_media_case_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/case_ref" }
    },
    "executable_tool_output_grounding_case_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/case_ref" }
    },
    "coverage_warnings": { "$ref": "#/$defs/string_array" },
    "fixture_ref_count": { "type": "integer", "minimum": 0 },
    "fixture_scenario_count": { "type": "integer", "minimum": 0 },
    "fixture_type_counts": { "$ref": "#/$defs/count_map" },
    "fixture_ref_counts_by_scenario": { "$ref": "#/$defs/count_map" }
  },
  "$defs": {
    "count_map": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "boolean_map": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "string_array_map": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/string_array" }
    },
    "case_ref": {
      "type": "object",
      "required": ["case_id", "scenario_id"],
      "properties": {
        "case_id": { "type": "string" },
        "scenario_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "failure_case_ref_map": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/case_ref" }
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2RegressionReplayReport",
  "type": "object",
  "required": [
    "schema_version",
    "replay_id",
    "source_case_book",
    "source_case_book_hash",
    "source_matrix",
    "source_matrix_hash",
    "dataset_id",
    "replay_case_count",
    "passed_count",
    "failed_count",
    "replay_ready",
    "maturity_status",
    "maturity_gate",
    "release_gate_summary",
    "cases",
    "metadata",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": { "const": "a2.regression_replay.v1" },
    "replay_id": { "type": "string" },
    "source_case_book": { "type": "string" },
    "source_case_book_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_matrix": { "type": "string" },
    "source_matrix_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dataset_id": { "type": "string" },
    "replay_case_count": { "type": "integer", "minimum": 0 },
    "passed_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "replay_ready": { "type": "boolean" },
    "maturity_status": { "type": "string" },
    "maturity_gate": { "type": "object" },
    "release_gate_summary": { "$ref": "#/$defs/release_gate_summary" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/replay_case" }
    },
    "metadata": { "type": "object" },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "replay_case": {
      "type": "object",
      "required": [
        "regression_id",
        "case_id",
        "scenario_id",
        "fixture_ref",
        "replay_status",
        "checks",
        "expected_local_failure_class",
        "observed_local_failure_class",
        "expected_llm_failure_class",
        "replay_grade",
        "evidence_refs"
      ],
      "properties": {
        "regression_id": { "type": "string" },
        "case_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "fixture_ref": { "type": "string" },
        "replay_status": { "type": "string" },
        "checks": { "type": "object" },
        "expected_local_failure_class": { "type": "string" },
        "observed_local_failure_class": { "type": "string" },
        "expected_llm_failure_class": { "type": "string" },
        "replay_grade": { "type": "object" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "release_gate_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "gate",
        "status",
        "release_gate_status",
        "blocks_release",
        "action",
        "required_action",
        "blocking_count",
        "current_replay_case_count",
        "target_replay_case_count",
        "missing_replay_case_count",
        "failed_replay_case_count",
        "reviewed_external_evidence_count",
        "reviewed_evidence_target_count",
        "missing_reviewed_evidence_count",
        "case_book_maturity_ready",
        "gaps",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": { "const": "a2.regression_replay.release_gate_summary.v1" },
        "gate": { "const": "C5" },
        "status": { "type": "string" },
        "release_gate_status": { "type": "string" },
        "blocks_release": { "type": "boolean" },
        "action": { "type": "string" },
        "required_action": { "type": "string" },
        "blocking_count": { "type": "integer", "minimum": 0 },
        "current_replay_case_count": { "type": "integer", "minimum": 0 },
        "target_replay_case_count": { "type": "integer", "minimum": 0 },
        "missing_replay_case_count": { "type": "integer", "minimum": 0 },
        "failed_replay_case_count": { "type": "integer", "minimum": 0 },
        "reviewed_external_evidence_count": { "type": "integer", "minimum": 0 },
        "reviewed_evidence_target_count": { "type": "integer", "minimum": 0 },
        "missing_reviewed_evidence_count": { "type": "integer", "minimum": 0 },
        "case_book_maturity_ready": { "type": "boolean" },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

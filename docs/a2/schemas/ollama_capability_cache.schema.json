{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releasefoundry.local/schemas/a2/ollama_capability_cache.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cache_key",
    "created_at_epoch_seconds",
    "receipt",
    "receipt_hash",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {
      "const": "a2.ollama_capability_cache.v1"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "created_at_epoch_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "receipt": {
      "type": "object"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "release_authority": {
      "const": false
    },
    "public_safe": {
      "const": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.io/schemas/a2/multimodal_miss_diagnosis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "diagnoses", "conclusions", "labels_changed", "raw_payload_included", "release_authority", "public_safe"],
  "properties": {
    "schema_version": {"const": "a2.multimodal_miss_diagnosis.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "diagnoses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_hash", "case_id", "evidence_hash", "expected_risk", "model_id", "observed_risk", "parse_state", "repeat"],
        "properties": {
          "artifact_hash": {"$ref": "#/$defs/hash"},
          "case_id": {"type": "string", "minLength": 1},
          "evidence_hash": {"$ref": "#/$defs/hash"},
          "expected_risk": {"type": "boolean"},
          "model_id": {"type": "string", "minLength": 1},
          "observed_risk": {"type": ["boolean", "null"]},
          "parse_state": {"type": "string", "minLength": 1},
          "repeat": {"type": "integer", "minimum": 1}
        }
      }
    },
    "conclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "labels_changed": {"const": false},
    "raw_payload_included": {"const": false},
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/provider_cancellation_acknowledgement.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acknowledgement_state",
    "provider_endpoint_hash",
    "runtime_version_hash",
    "provider_receipt_hash",
    "request_cancellation_proven",
    "release_authority",
    "blockers",
    "public_safe"
  ],
  "properties": {
    "schema_version": {
      "const": "a2.provider_cancellation_acknowledgement.v1"
    },
    "acknowledgement_state": {
      "enum": [
        "acknowledged",
        "rejected",
        "unavailable"
      ]
    },
    "provider_endpoint_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "runtime_version_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "provider_receipt_hash": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "request_cancellation_proven": {
      "type": "boolean"
    },
    "release_authority": {
      "const": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "public_safe": {
      "const": true
    }
  }
}

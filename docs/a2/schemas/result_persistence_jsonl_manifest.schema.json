{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/result_persistence_jsonl_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path",
    "record_count",
    "file_sha256",
    "record_hashes",
    "previous_manifest_hash",
    "sequence_number",
    "chain_hash",
    "public_safe"
  ],
  "properties": {
    "schema_version": {
      "const": "a2.result_persistence_jsonl_manifest.v1"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "previous_manifest_hash": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "chain_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "public_safe": {
      "const": true
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    }
  }
}

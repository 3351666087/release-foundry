{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releasefoundry.local/schemas/a2/deterministic_safe_controls.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controls",
    "provider_labels_used",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "a2.deterministic_safe_control_expansion.v1"},
    "controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "artifact_path",
          "artifact_hash",
          "expected_risk",
          "semantic_label"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "artifact_path": {"type": "string", "minLength": 1},
          "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "expected_risk": {"const": false},
          "semantic_label": {"type": "string", "pattern": "^text_free_"}
        }
      }
    },
    "provider_labels_used": {"const": false},
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  }
}

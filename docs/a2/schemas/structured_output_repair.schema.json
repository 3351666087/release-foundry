{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/structured_output_repair.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "repair_policy_hash", "expected_repair_policy_hash", "original_output_hash", "repaired_output_hash", "original_output", "repaired_output", "missing_required_fields", "repair_count_before", "repair_count_after", "maximum_repair_count", "semantic_observation_modified", "reviewer_identity_hash", "calibration_entry_eligible", "calibration_state", "release_authority", "human_review_required", "blockers", "public_safe"],
  "properties": {
    "schema_version": {"const": "a2.structured_output_repair.v1"},
    "state": {"enum": ["blocked", "not_required", "repaired_for_review"]},
    "repair_policy_hash": {"$ref": "#/$defs/optionalHash"},
    "expected_repair_policy_hash": {"$ref": "#/$defs/optionalHash"},
    "original_output_hash": {"$ref": "#/$defs/hash"},
    "repaired_output_hash": {"$ref": "#/$defs/optionalHash"},
    "original_output": {"type": "object"},
    "repaired_output": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "missing_required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "repair_count_before": {"type": "integer", "minimum": 0},
    "repair_count_after": {"type": "integer", "minimum": 0},
    "maximum_repair_count": {"type": "integer", "minimum": 0},
    "semantic_observation_modified": {"type": "boolean"},
    "reviewer_identity_hash": {"$ref": "#/$defs/optionalHash"},
    "calibration_entry_eligible": {"type": "boolean"},
    "calibration_state": {"const": "uncalibrated"},
    "release_authority": {"const": false},
    "human_review_required": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "public_safe": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "optionalHash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
  }
}

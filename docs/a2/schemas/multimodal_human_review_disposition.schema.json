{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.io/schemas/a2/multimodal_human_review_disposition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queue_receipt_hash", "receipt_id", "comparison_hash", "comparison_artifact_hash", "artifact_hash", "case_id", "reviewer_identity_hash", "reviewer_identity_class", "reviewer_role", "disposition", "rationale_code", "release_authority", "raw_payload_included", "public_safe"],
  "properties": {
    "schema_version": {"const": "a2.multimodal_human_review_disposition.v1"},
    "queue_receipt_hash": {"$ref": "#/$defs/hash"},
    "receipt_id": {"$ref": "#/$defs/hash"},
    "comparison_hash": {"$ref": "#/$defs/hash"},
    "comparison_artifact_hash": {"$ref": "#/$defs/hash"},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "case_id": {"type": "string", "minLength": 1},
    "reviewer_identity_hash": {"$ref": "#/$defs/hash"},
    "reviewer_identity_class": {"enum": ["human_reviewer", "test_review_fixture"]},
    "reviewer_role": {"const": "multimodal_safety_reviewer"},
    "disposition": {"enum": ["uphold_left", "uphold_right", "inconclusive", "request_more_evidence", "reference_unavailable_collect_more_evidence"]},
    "disposition_text": {"const": "reference unavailable; collect more evidence"},
    "rationale_code": {"type": "string", "pattern": "^[a-z0-9_]{3,64}$"},
    "release_authority": {"const": false},
    "raw_payload_included": {"const": false},
    "public_safe": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "reference_unavailable_collect_more_evidence"
          }
        },
        "required": ["disposition"]
      },
      "then": {"required": ["disposition_text"]},
      "else": {"not": {"required": ["disposition_text"]}}
    }
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}

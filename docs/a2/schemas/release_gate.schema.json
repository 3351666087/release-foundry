{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2ReleaseGateReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "release_candidate",
    "decision",
    "exit_code",
    "risk_score",
    "hard_gate_ids",
    "current_commercial_gate",
    "ready_for_commercial_gate",
    "blocking_gate_count",
    "evidence_blocker_count",
    "scenario_selection_blocker_count",
    "a1_output_policy_blocker_count",
    "judge_registry_blocker_count",
    "warning_count",
    "scenario_selection_gate",
    "a1_output_policy_gate",
    "judge_registry_binding",
    "judge_registry_hash",
    "source_commercial_readiness_hash",
    "source_evidence_readiness_hash",
    "source_calibration_matrix_hash",
    "source_case_book_hash",
    "source_regression_replay_hash",
    "source_scenario_selection_hash",
    "source_a1_evidence_index_hash",
    "source_judge_registry_hash",
    "artifact_hash",
    "blockers",
    "warnings",
    "required_evidence",
    "pr_annotations",
    "review_workflow",
    "machine_contract",
    "evidence_refs",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "a2.release_gate.v1" },
    "report_id": { "type": "string" },
    "release_candidate": { "type": "object" },
    "decision": { "enum": ["pass", "warn", "block"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "hard_gate_ids": { "$ref": "#/$defs/string_array" },
    "current_commercial_gate": { "type": "string" },
    "ready_for_commercial_gate": { "type": "boolean" },
    "blocking_gate_count": { "type": "integer", "minimum": 0 },
    "evidence_blocker_count": { "type": "integer", "minimum": 0 },
    "scenario_selection_blocker_count": { "type": "integer", "minimum": 0 },
    "a1_output_policy_blocker_count": { "type": "integer", "minimum": 0 },
    "judge_registry_blocker_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "scenario_selection_gate": { "$ref": "#/$defs/scenario_selection_gate" },
    "a1_output_policy_gate": { "$ref": "#/$defs/a1_output_policy_gate" },
    "judge_registry_binding": { "$ref": "#/$defs/judge_registry_binding" },
    "judge_registry_hash": { "$ref": "#/$defs/hash_ref" },
    "source_commercial_readiness_hash": { "$ref": "#/$defs/hash_ref" },
    "source_evidence_readiness_hash": { "$ref": "#/$defs/hash_ref" },
    "source_calibration_matrix_hash": { "$ref": "#/$defs/hash_ref" },
    "source_case_book_hash": { "$ref": "#/$defs/hash_ref" },
    "source_regression_replay_hash": { "$ref": "#/$defs/hash_ref" },
    "source_scenario_selection_hash": { "$ref": "#/$defs/hash_ref" },
    "source_a1_evidence_index_hash": { "$ref": "#/$defs/hash_ref" },
    "source_judge_registry_hash": { "$ref": "#/$defs/hash_ref" },
    "artifact_hash": { "$ref": "#/$defs/hash_ref" },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/release_item" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/release_item" }
    },
    "required_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/required_evidence" }
    },
    "pr_annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/pr_annotation" }
    },
    "review_workflow": { "type": "object" },
    "machine_contract": { "type": "object" },
    "evidence_refs": { "$ref": "#/$defs/string_array" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "hash_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "release_item": {
      "type": "object",
      "required": ["type", "severity", "summary", "evidence_refs"],
      "properties": {
        "type": { "type": "string" },
        "gate": { "type": "string" },
        "status": { "type": "string" },
        "severity": { "type": "string" },
        "summary": { "type": "string" },
        "required_action": { "type": "string" },
        "missing_count": { "type": "integer", "minimum": 0 },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "scenario_selection_gate": {
      "type": "object",
      "required": [
        "status",
        "ready",
        "coverage_ready",
        "minimums_ready",
        "selection_id",
        "project_id",
        "environment",
        "selected_scenario_count",
        "gaps",
        "evidence_refs"
      ],
      "properties": {
        "status": { "enum": ["ready", "needs_attention", "not_evaluated"] },
        "ready": { "type": "boolean" },
        "coverage_ready": { "type": "boolean" },
        "minimums_ready": { "type": "boolean" },
        "selection_id": { "type": "string" },
        "project_id": { "type": "string" },
        "environment": { "type": "string" },
        "selected_scenario_count": { "type": "integer", "minimum": 0 },
        "observed_minimums": { "type": "object" },
        "release_gate_inputs": { "type": "object" },
        "gaps": { "$ref": "#/$defs/string_array" },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "a1_output_policy_gate": {
      "type": "object",
      "required": [
        "status",
        "ready",
        "source_schema_version",
        "label",
        "index_path",
        "total_records",
        "dangerous_counts",
        "safe_counts",
        "evidence_refs"
      ],
      "properties": {
        "status": { "enum": ["ready", "blocked", "not_evaluated"] },
        "ready": { "type": "boolean" },
        "source_schema_version": { "type": "string" },
        "label": { "type": "string" },
        "index_path": { "type": "string" },
        "total_records": { "type": "integer", "minimum": 0 },
        "dangerous_counts": {
          "type": "object",
          "required": ["unsafe_real_nonprivate_override", "private_required_but_not_private"],
          "properties": {
            "unsafe_real_nonprivate_override": { "type": "integer", "minimum": 0 },
            "private_required_but_not_private": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "safe_counts": { "type": "object" },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "judge_registry_binding": {
      "type": "object",
      "required": [
        "status",
        "ready",
        "registry_id",
        "registry_hash",
        "active_release_id",
        "default_version",
        "all_declared_judges_observed",
        "gaps",
        "evidence_refs"
      ],
      "properties": {
        "status": { "enum": ["verified", "blocked"] },
        "ready": { "type": "boolean" },
        "registry_id": { "type": "string" },
        "registry_hash": { "$ref": "#/$defs/hash_ref" },
        "active_release_id": { "type": "string" },
        "default_version": { "type": "string" },
        "all_declared_judges_observed": { "type": "boolean" },
        "gaps": { "$ref": "#/$defs/string_array" },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "required_evidence": {
      "type": "object",
      "required": ["source", "required_count", "current_available", "private_input_ref", "collection_packet_ref", "commands"],
      "properties": {
        "source": { "type": "string" },
        "required_count": { "type": "integer", "minimum": 0 },
        "current_available": { "type": "integer", "minimum": 0 },
        "private_input_ref": { "type": "string" },
        "collection_packet_ref": { "type": "string" },
        "commands": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "pr_annotation": {
      "type": "object",
      "required": ["level", "title", "message", "evidence_refs"],
      "properties": {
        "level": { "enum": ["failure", "warning", "notice"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

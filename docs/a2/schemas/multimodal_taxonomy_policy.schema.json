{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/multimodal_taxonomy_policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minimum_positive_denominators",
    "minimum_negative_denominators",
    "minimum_recall_wilson_lower",
    "minimum_specificity_wilson_lower",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {
      "const": "a2.multimodal_taxonomy_policy.v1"
    },
    "minimum_positive_denominators": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "minimum_negative_denominators": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "minimum_recall_wilson_lower": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "minimum_specificity_wilson_lower": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "release_authority": {
      "const": false
    },
    "public_safe": {
      "const": true
    }
  }
}

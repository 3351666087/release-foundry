{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/ocr_observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "adapter_version_hash", "minimum_confidence", "state", "text", "text_hash", "token_boxes_hash", "ocr_binding_hash", "token_count", "minimum_observed_confidence", "confidence_summary", "latency_ms", "process_rss_before_bytes", "process_rss_after_bytes", "process_rss_delta_bytes", "process_rss_peak_bytes", "process_rss_peak_delta_bytes", "release_authority", "blockers", "public_safe"],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "state": {"enum": ["unavailable", "failed", "completed"]},
    "text": {"type": "string"},
    "text_hash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
    "token_boxes_hash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
    "ocr_binding_hash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
    "token_count": {"type": "integer", "minimum": 0},
    "minimum_observed_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confidence_summary": {"type": "object", "additionalProperties": false, "required": ["count", "minimum", "maximum", "mean"], "properties": {"count": {"type": "integer", "minimum": 0}, "minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}, "mean": {"type": ["number", "null"]}}},
    "latency_ms": {"type": "number", "minimum": 0},
    "process_rss_before_bytes": {"type": ["integer", "null"]},
    "process_rss_after_bytes": {"type": ["integer", "null"]},
    "process_rss_delta_bytes": {"type": ["integer", "null"]},
    "process_rss_peak_bytes": {"type": ["integer", "null"], "minimum": 0},
    "process_rss_peak_delta_bytes": {"type": ["integer", "null"], "minimum": 0},
    "release_authority": {"const": false},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "public_safe": {"const": true}
  }
}

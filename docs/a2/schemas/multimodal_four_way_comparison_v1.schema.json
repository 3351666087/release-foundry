{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.io/schemas/a2/multimodal_four_way_comparison_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_artifact_hash", "evidence_hashes",
    "partial_journal_hashes", "provider_bindings", "comparisons", "summary", "pairwise_summaries",
    "human_review_queue_receipts", "release_authority",
    "raw_payload_included", "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "a2.multimodal_four_way_comparison.v1"},
    "comparison_artifact_hash": {"$ref": "#/$defs/hash"},
    "evidence_hashes": {"$ref": "#/$defs/providerHashes"},
    "partial_journal_hashes": {"$ref": "#/$defs/providerOptionalHashes"},
    "provider_bindings": {
      "type": "object", "minProperties": 4, "maxProperties": 4,
      "propertyNames": {"pattern": "^(?!\\s)(?!.*\\s$)(?!.*::).+$"},
      "additionalProperties": {"$ref": "#/$defs/providerBinding"}
    },
    "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "summary": {"$ref": "#/$defs/summary"},
    "pairwise_summaries": {
      "type": "object", "minProperties": 6, "maxProperties": 6,
      "additionalProperties": {"$ref": "#/$defs/pairwiseSummary"}
    },
    "human_review_queue_receipts": {
      "type": "array", "items": {"$ref": "#/$defs/receipt"}
    },
    "designated_high_quality_reference": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*::).+$"
    },
    "release_authority": {"const": false},
    "raw_payload_included": {"const": false},
    "public_safe": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "optionalHash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
    "providerHashes": {
      "type": "object", "minProperties": 4, "maxProperties": 4,
      "propertyNames": {"pattern": "^(?!\\s)(?!.*\\s$)(?!.*::).+$"},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "providerOptionalHashes": {
      "type": "object", "minProperties": 4, "maxProperties": 4,
      "propertyNames": {"pattern": "^(?!\\s)(?!.*\\s$)(?!.*::).+$"},
      "additionalProperties": {"$ref": "#/$defs/optionalHash"}
    },
    "providerState": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "parse_state", "observed_risk"],
      "properties": {
        "eligible": {"type": "boolean"},
        "parse_state": {"type": "string", "minLength": 1},
        "observed_risk": {"type": ["boolean", "null"]}
      }
    },
    "providerBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "prompt_hash", "output_schema_hash", "provider_capability_hash"
      ],
      "properties": {
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "output_schema_hash": {"$ref": "#/$defs/hash"},
        "provider_capability_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "four_way_agreement", "three_way_agreement_with_unavailable",
        "pairwise_agreement_with_unavailable", "semantic_disagreement", "unavailable"
      ],
      "properties": {
        "four_way_agreement": {"type": "integer", "minimum": 0},
        "three_way_agreement_with_unavailable": {"type": "integer", "minimum": 0},
        "pairwise_agreement_with_unavailable": {"type": "integer", "minimum": 0},
        "semantic_disagreement": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "pairwiseSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["agreement", "semantic_disagreement", "unavailable"],
      "properties": {
        "agreement": {"type": "integer", "minimum": 0},
        "semantic_disagreement": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_id", "artifact_hash", "repeat", "eligible_provider_count",
        "provider_states", "comparison_state", "human_review_required"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/hash"},
        "repeat": {"type": "integer", "minimum": 1},
        "eligible_provider_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "provider_states": {
          "type": "object", "minProperties": 4, "maxProperties": 4,
          "additionalProperties": {"$ref": "#/$defs/providerState"}
        },
        "comparison_state": {
          "enum": [
            "four_way_agreement", "three_way_agreement_with_unavailable",
            "pairwise_agreement_with_unavailable", "semantic_disagreement", "unavailable"
          ]
        },
        "human_review_required": {"type": "boolean"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "receipt_id", "comparison_artifact_hash", "comparison_hash",
        "artifact_hash", "case_id", "repeat", "eligibility_rule",
        "queue_state", "reviewer_role", "release_authority"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/hash"},
        "comparison_artifact_hash": {"$ref": "#/$defs/hash"},
        "comparison_hash": {"$ref": "#/$defs/hash"},
        "artifact_hash": {"$ref": "#/$defs/hash"},
        "case_id": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "eligibility_rule": {
          "enum": [
            "at_least_two_eligible_and_semantically_disagree",
            "designated_high_quality_reference_unavailable"
          ]
        },
        "reference_provider": {
          "type": "string", "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)(?!.*::).+$"
        },
        "queue_state": {"const": "awaiting_human_review"},
        "reviewer_role": {"const": "multimodal_safety_reviewer"},
        "release_authority": {"const": false}
      }
    }
  }
}

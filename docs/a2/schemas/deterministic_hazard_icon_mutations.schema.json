{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/deterministic_hazard_icon_mutations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_artifact_hash", "icon_detector", "icon_detector_version_hash", "mutations", "release_authority", "public_safe"],
  "properties": {
    "schema_version": {"const": "a2.deterministic_hazard_icon_mutations.v1"},
    "base_artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "icon_detector": {"type": "string", "minLength": 1},
    "icon_detector_version_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "artifact_hash", "warning_icon_present"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "warning_icon_present": {"type": "boolean"}
        }
      }
    },
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  }
}

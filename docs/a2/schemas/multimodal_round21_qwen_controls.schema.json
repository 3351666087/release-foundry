{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releasefoundry.local/schemas/a2/multimodal_round21_qwen_controls.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_binding", "controls", "structured_output_state", "specificity_comparison_state", "qualification_state", "blockers", "release_authority", "public_safe"],
  "properties": {
    "schema_version": {"const": "a2.multimodal_round21_qwen_controls.v1"},
    "model_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "model_version", "prompt_hash", "seed", "temperature"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"$ref": "#/$defs/hash"},
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "seed": {"type": "integer"},
        "temperature": {"type": "number", "minimum": 0}
      }
    },
    "controls": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wall_seconds", "response", "done_reason", "eval_count"],
        "properties": {
          "wall_seconds": {"type": "number", "minimum": 0},
          "response": {"type": "string"},
          "done_reason": {"type": "string", "minLength": 1},
          "eval_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "structured_output_state": {"const": "malformed_empty_response"},
    "specificity_comparison_state": {"const": "not_comparable"},
    "qualification_state": {"const": "blocked"},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}

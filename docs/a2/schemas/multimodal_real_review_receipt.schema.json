{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.io/schemas/a2/multimodal_real_review_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "queue_receipt_hash",
    "comparison_artifact_hash",
    "comparison_hash",
    "artifact_hash",
    "case_id",
    "reviewer_identity_hash",
    "reviewer_identity_class",
    "review_completed_at",
    "disposition",
    "rationale_code",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "a2.multimodal_real_review_receipt.v1"},
    "receipt_id": {"$ref": "#/$defs/hash"},
    "queue_receipt_hash": {"$ref": "#/$defs/hash"},
    "comparison_artifact_hash": {"$ref": "#/$defs/hash"},
    "comparison_hash": {"$ref": "#/$defs/hash"},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "case_id": {"type": "string", "minLength": 1},
    "reviewer_identity_hash": {"$ref": "#/$defs/hash"},
    "reviewer_identity_class": {"const": "human_reviewer"},
    "review_completed_at": {"type": "string", "format": "date-time"},
    "disposition": {
      "enum": [
        "confirm_risk",
        "confirm_safe",
        "request_more_evidence",
        "abstain"
      ]
    },
    "rationale_code": {"type": "string", "minLength": 1},
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releasefoundry.local/schemas/a2/multimodal_runtime_matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "runtime",
    "binding",
    "trials",
    "latency_distribution_seconds",
    "mini_suite_metrics",
    "metric_denominator_rule",
    "qualification_state",
    "blockers",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "a2.multimodal_runtime_matrix.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "ollama_version"],
      "properties": {
        "provider_id": {"const": "ollama-local"},
        "ollama_version": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_hash", "temperature", "seed", "image_size"],
      "properties": {
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "temperature": {"type": "number"},
        "seed": {"type": "integer"},
        "image_size": {"const": "224x224"}
      }
    },
    "trials": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/trial"}
    },
    "latency_distribution_seconds": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/latency"}
    },
    "mini_suite_metrics": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/metrics"}
    },
    "metric_denominator_rule": {
      "const": "completed_and_valid_json_semantics_only"
    },
    "qualification_state": {"const": "blocked"},
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "optionalHash": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_digest",
        "case_id",
        "expected_risk",
        "format_mode",
        "num_predict",
        "repeat",
        "artifact_hash",
        "prompt_hash",
        "request_hash",
        "http_state",
        "parse_state",
        "response_hash",
        "observed_risk",
        "wall_seconds",
        "done_reason",
        "eval_count",
        "error_class",
        "raw_payload_included",
        "release_authority"
      ],
      "properties": {
        "model_id": {"enum": ["qwen3-vl:4b", "llava:7b"]},
        "model_digest": {"$ref": "#/$defs/hash"},
        "case_id": {"enum": ["safe", "attack"]},
        "expected_risk": {"type": "boolean"},
        "format_mode": {"enum": ["json", "plain"]},
        "num_predict": {"enum": [128, 256]},
        "repeat": {"type": "integer", "minimum": 1},
        "artifact_hash": {"$ref": "#/$defs/hash"},
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "request_hash": {"$ref": "#/$defs/hash"},
        "http_state": {"enum": ["completed", "failed"]},
        "parse_state": {
          "enum": ["not_attempted", "invalid_json", "invalid_semantics", "valid_json"]
        },
        "response_hash": {"$ref": "#/$defs/optionalHash"},
        "observed_risk": {"type": ["boolean", "null"]},
        "wall_seconds": {"type": "number", "minimum": 0},
        "done_reason": {"type": "string"},
        "eval_count": {"type": ["integer", "null"], "minimum": 0},
        "error_class": {"type": "string"},
        "raw_payload_included": {"const": false},
        "release_authority": {"const": false}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "median", "p95_nearest_rank", "max"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "min": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "p95_nearest_rank": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_count", "sensitivity", "specificity"],
      "properties": {
        "eligible_count": {"type": "integer", "minimum": 0},
        "sensitivity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "specificity": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}

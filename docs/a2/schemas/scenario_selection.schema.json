{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2ScenarioSelectionReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "selection_id",
    "source_pack_id",
    "source_scenario_count",
    "tenant",
    "project",
    "environment",
    "selection_context",
    "policy_profile",
    "selection_profile",
    "effective_criteria",
    "selected_scenario_count",
    "selected_scenarios",
    "coverage_summary",
    "minimums_summary",
    "a3_consumption_summary",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "a2.scenario_selection.v1" },
    "report_id": { "type": "string" },
    "selection_id": { "type": "string" },
    "source_pack_id": { "type": "string" },
    "source_scenario_count": { "type": "integer", "minimum": 0 },
    "tenant": { "$ref": "#/$defs/tenant" },
    "project": { "type": "object" },
    "environment": { "type": "string" },
    "selection_context": { "type": "object" },
    "policy_profile": { "$ref": "#/$defs/policy_profile" },
    "selection_profile": { "type": "object" },
    "effective_criteria": { "type": "object" },
    "selected_scenario_count": { "type": "integer", "minimum": 0 },
    "selected_scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/selected_scenario" }
    },
    "coverage_summary": { "$ref": "#/$defs/coverage_summary" },
    "minimums_summary": { "$ref": "#/$defs/minimums_summary" },
    "a3_consumption_summary": { "$ref": "#/$defs/a3_consumption_summary" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tenant": {
      "type": "object",
      "required": ["organization_id", "workspace_id", "tenant_id"],
      "properties": {
        "organization_id": { "type": "string" },
        "workspace_id": { "type": "string" },
        "tenant_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "policy_profile": {
      "type": "object",
      "required": [
        "policy_id",
        "judge_policy_id",
        "environment",
        "blocking_mode",
        "release_gate_decision",
        "per_project_policy",
        "per_environment_policy"
      ],
      "properties": {
        "policy_id": { "type": "string" },
        "judge_policy_id": { "type": "string" },
        "environment": { "type": "string" },
        "blocking_mode": { "type": "string" },
        "release_gate_decision": { "type": "string" },
        "per_project_policy": { "type": "boolean" },
        "per_environment_policy": { "type": "boolean" },
        "blocking_failure_classes": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "selected_scenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "title",
        "family",
        "difficulty",
        "risk_tier",
        "matched_capability_axes",
        "matched_tenant_saas_tags",
        "is_media_or_multimodal",
        "media_required_match",
        "golden_case_refs",
        "run_fixture_refs",
        "regression_refs",
        "coverage_roles",
        "selection_score",
        "selection_reason"
      ],
      "properties": {
        "scenario_id": { "type": "string" },
        "title": { "type": "string" },
        "family": { "type": "string" },
        "difficulty": { "type": "string" },
        "risk_tier": { "enum": ["low", "medium", "high", "critical"] },
        "capability_axes": { "$ref": "#/$defs/string_array" },
        "matched_capability_axes": { "$ref": "#/$defs/string_array" },
        "matched_tenant_saas_tags": { "$ref": "#/$defs/string_array" },
        "is_media_or_multimodal": { "type": "boolean" },
        "media_required_match": { "type": "boolean" },
        "action_environments": { "$ref": "#/$defs/string_array" },
        "primary_failure_class": { "type": "string" },
        "golden_case_refs": { "type": "array", "items": { "type": "object" } },
        "run_fixture_refs": { "type": "array", "items": { "type": "object" } },
        "regression_refs": { "type": "array", "items": { "type": "object" } },
        "coverage_roles": { "type": "object" },
        "selection_score": { "type": "integer", "minimum": 0 },
        "selection_reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "coverage_summary": {
      "type": "object",
      "required": [
        "source_scenario_count",
        "selected_scenario_count",
        "coverage_ready",
        "requested_capability_axes",
        "covered_capability_axes",
        "capability_axis_counts",
        "requested_capability_axis_counts",
        "required_capability_axis_minimums",
        "required_capability_axis_minimum_status",
        "missing_capability_axis_minimums",
        "missing_capability_axes",
        "requested_risk_tiers",
        "risk_tier_counts",
        "missing_risk_tiers",
        "media_requirement",
        "media_scenario_count",
        "media_scenario_ids",
        "media_requirement_met",
        "media_coverage",
        "required_tenant_saas_tags",
        "required_tag_minimum",
        "required_tag_counts",
        "required_tag_minimum_status",
        "missing_required_tag_minimums",
        "requested_tenant_saas_tags",
        "tenant_saas_tag_counts",
        "missing_tenant_saas_tags",
        "family_counts",
        "action_environment_counts"
      ],
      "properties": {
        "source_scenario_count": { "type": "integer", "minimum": 0 },
        "selected_scenario_count": { "type": "integer", "minimum": 0 },
        "coverage_ready": { "type": "boolean" },
        "requested_capability_axes": { "$ref": "#/$defs/string_array" },
        "covered_capability_axes": { "$ref": "#/$defs/string_array" },
        "capability_axis_counts": { "type": "object" },
        "requested_capability_axis_counts": { "type": "object" },
        "required_capability_axis_minimums": { "type": "object" },
        "required_capability_axis_minimum_status": { "type": "object" },
        "missing_capability_axis_minimums": { "type": "object" },
        "missing_capability_axes": { "$ref": "#/$defs/string_array" },
        "requested_risk_tiers": { "$ref": "#/$defs/string_array" },
        "risk_tier_counts": { "type": "object" },
        "missing_risk_tiers": { "$ref": "#/$defs/string_array" },
        "media_requirement": { "type": "string" },
        "media_scenario_count": { "type": "integer", "minimum": 0 },
        "media_scenario_ids": { "$ref": "#/$defs/string_array" },
        "media_requirement_met": { "type": "boolean" },
        "media_coverage": { "type": "object" },
        "required_tenant_saas_tags": { "$ref": "#/$defs/string_array" },
        "required_tag_minimum": { "type": "integer", "minimum": 0 },
        "required_tag_counts": { "type": "object" },
        "required_tag_minimum_status": { "type": "object" },
        "missing_required_tag_minimums": { "type": "object" },
        "requested_tenant_saas_tags": { "$ref": "#/$defs/string_array" },
        "tenant_saas_tag_counts": { "type": "object" },
        "missing_tenant_saas_tags": { "$ref": "#/$defs/string_array" },
        "family_counts": { "type": "object" },
        "action_environment_counts": { "type": "object" }
      },
      "additionalProperties": true
    },
    "minimums_summary": {
      "type": "object",
      "required": [
        "requested_minimums",
        "observed",
        "checks",
        "minimums_ready",
        "gaps",
        "failure_classes",
        "golden_case_scenario_ids",
        "run_fixture_scenario_ids",
        "regression_scenario_ids"
      ],
      "properties": {
        "requested_minimums": { "type": "object" },
        "observed": { "type": "object" },
        "checks": { "type": "object" },
        "minimums_ready": { "type": "boolean" },
        "gaps": { "$ref": "#/$defs/string_array" },
        "failure_classes": { "$ref": "#/$defs/string_array" },
        "golden_case_scenario_ids": { "$ref": "#/$defs/string_array" },
        "run_fixture_scenario_ids": { "$ref": "#/$defs/string_array" },
        "regression_scenario_ids": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "a3_consumption_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "tenant_project_environment",
        "selected_scenario_ids",
        "scenario_count",
        "policy_profile",
        "coverage",
        "minimums",
        "dashboard_cards",
        "release_gate_inputs",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": { "const": "a2.a3_scenario_selection_summary.v1" },
        "tenant_project_environment": { "type": "object" },
        "selected_scenario_ids": { "$ref": "#/$defs/string_array" },
        "scenario_count": { "type": "integer", "minimum": 0 },
        "policy_profile": { "type": "object" },
        "coverage": { "type": "object" },
        "minimums": { "type": "object" },
        "dashboard_cards": { "type": "array", "items": { "type": "object" } },
        "release_gate_inputs": { "type": "object" },
        "evidence_refs": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2EvidenceReadinessReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "dataset_id",
    "status",
    "ready_for_external_collection",
    "readiness_checks",
    "calibration_case_count",
    "calibration_cases",
    "ashr_grading_preflight",
    "a1_real_api_evidence",
    "ashr_public_merge_gate",
    "official_sdk_smoke",
    "semantic_judge_preflight",
    "semantic_live_merge_gate",
    "batch_plan_refs",
    "redaction_policy",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "a2.evidence_readiness.v1" },
    "report_id": { "type": "string" },
    "dataset_id": { "type": "string" },
    "status": { "type": "string" },
    "ready_for_external_collection": { "type": "boolean" },
    "readiness_checks": { "$ref": "#/$defs/boolean_map" },
    "calibration_case_count": { "type": "integer", "minimum": 0 },
    "calibration_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/calibration_case" }
    },
    "ashr_grading_preflight": { "$ref": "#/$defs/preflight" },
    "a1_real_api_evidence": { "$ref": "#/$defs/a1_real_api_evidence" },
    "ashr_public_merge_gate": { "type": "object" },
    "official_sdk_smoke": { "$ref": "#/$defs/official_sdk_smoke" },
    "semantic_judge_preflight": { "$ref": "#/$defs/preflight" },
    "semantic_live_merge_gate": { "type": "object" },
    "batch_plan_refs": { "$ref": "#/$defs/string_array" },
    "redaction_policy": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "boolean_map": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "calibration_case": {
      "type": "object",
      "required": ["case_id", "scenario_id", "fixture_ref", "calibration_focus"],
      "properties": {
        "case_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "fixture_ref": { "type": "string" },
        "calibration_focus": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "preflight": {
      "type": "object",
      "required": ["source", "expected_observation_count", "commands"],
      "properties": {
        "source": { "type": "string" },
        "expected_observation_count": { "type": "integer", "minimum": 0 },
        "commands": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "a1_real_api_evidence": {
      "type": "object",
      "required": [
        "available",
        "index_path",
        "total_records",
        "quota_block_count",
        "real_ok_functions",
        "real_record_count",
        "real_read_status_counts",
        "real_quota_gate",
        "api_probe_gate_validation",
        "c3_grading_ready"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "index_path": { "type": "string" },
        "schema_version": { "type": "string" },
        "label": { "type": "string" },
        "field_map_version": { "type": "string" },
        "total_records": { "type": "integer", "minimum": 0 },
        "status_counts": { "$ref": "#/$defs/count_map" },
        "function_counts": { "$ref": "#/$defs/count_map" },
        "quota_block_count": { "type": "integer", "minimum": 0 },
        "real_ok_functions": { "$ref": "#/$defs/string_array" },
        "mutating_functions_present": { "$ref": "#/$defs/string_array" },
        "real_record_count": { "type": "integer", "minimum": 0 },
        "real_read_status_counts": { "$ref": "#/$defs/count_map" },
        "real_create_request_status_counts": { "$ref": "#/$defs/count_map" },
        "real_create_request_error_kind_counts": { "$ref": "#/$defs/count_map" },
        "real_quota_gate": { "$ref": "#/$defs/real_quota_gate" },
        "api_probe_gate_validation": { "$ref": "#/$defs/api_probe_gate_validation" },
        "c3_candidate_record_count": { "type": "integer", "minimum": 0 },
        "c3_grading_ready": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "real_quota_gate": {
      "type": "object",
      "required": [
        "blocked",
        "blocked_count",
        "blocked_functions",
        "create_request_blocked",
        "quota_keys",
        "private_record_refs",
        "public_action"
      ],
      "properties": {
        "blocked": { "type": "boolean" },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "blocked_functions": { "$ref": "#/$defs/string_array" },
        "create_request_blocked": { "type": "boolean" },
        "quota_keys": { "$ref": "#/$defs/string_array" },
        "private_record_refs": { "$ref": "#/$defs/string_array" },
        "public_action": { "type": "string" }
      },
      "additionalProperties": true
    },
    "api_probe_gate_validation": {
      "type": "object",
      "required": [
        "available",
        "schema_ref",
        "plan_batch_count",
        "validate_gate_count",
        "plan_batch_status_counts",
        "validate_gate_status_counts",
        "ok_validate_gate_count",
        "error_validate_gate_count",
        "blocked_plan_batch_count",
        "private_record_refs",
        "release_interpretation"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "schema_ref": { "type": "string" },
        "plan_batch_count": { "type": "integer", "minimum": 0 },
        "validate_gate_count": { "type": "integer", "minimum": 0 },
        "plan_batch_status_counts": { "$ref": "#/$defs/count_map" },
        "validate_gate_status_counts": { "$ref": "#/$defs/count_map" },
        "ok_validate_gate_count": { "type": "integer", "minimum": 0 },
        "error_validate_gate_count": { "type": "integer", "minimum": 0 },
        "blocked_plan_batch_count": { "type": "integer", "minimum": 0 },
        "private_record_refs": { "$ref": "#/$defs/string_array" },
        "release_interpretation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "official_sdk_smoke": {
      "type": "object",
      "required": [
        "available",
        "path",
        "api_call_count",
        "ok_call_count",
        "error_call_count",
        "call_names",
        "all_required_calls_reached",
        "read_only_reachable"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "path": { "type": "string" },
        "schema_version": { "type": "string" },
        "sdk_source": { "type": "string" },
        "base_url": { "type": "string" },
        "api_call_count": { "type": "integer", "minimum": 0 },
        "ok_call_count": { "type": "integer", "minimum": 0 },
        "error_call_count": { "type": "integer", "minimum": 0 },
        "call_names": { "$ref": "#/$defs/string_array" },
        "all_required_calls_reached": { "type": "boolean" },
        "read_only_reachable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "count_map": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  },
  "additionalProperties": true
}

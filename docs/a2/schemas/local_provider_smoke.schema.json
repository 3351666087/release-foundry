{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.io/schemas/a2/local_provider_smoke.schema.json",
  "title": "A2 Local Provider Smoke Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider_id", "model_id", "model_digest", "modality",
    "status", "capability_state", "calibration_state", "duration_bucket",
    "logical_call_id", "response_hash", "content_hashes",
    "raw_payload_included", "secret_included"
  ],
  "properties": {
    "schema_version": {"const": "a2.local_provider_smoke.v1"},
    "provider_id": {"const": "ollama-local"},
    "model_id": {"type": "string", "minLength": 1},
    "model_digest": {"anyOf": [{"const": ""}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "modality": {"enum": ["text", "image"]},
    "status": {"enum": ["completed", "timeout", "invalid_response", "provider_unavailable", "provider_error", "blocked", "unsupported", "rate_limited", "budget_blocked"]},
    "capability_state": {"enum": ["callable", "protocol_reachable", "unavailable"]},
    "calibration_state": {"const": "uncalibrated"},
    "duration_bucket": {"enum": ["not_recorded", "under_1s", "1_to_10s", "10_to_60s", "1_to_5m", "over_5m"]},
    "logical_call_id": {"type": ["string", "null"]},
    "response_hash": {"type": ["string", "null"]},
    "content_hashes": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "raw_payload_included": {"const": false},
    "secret_included": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"capability_state": {"const": "callable"}}}},
    {"if": {"properties": {"status": {"enum": ["timeout", "invalid_response"]}}}, "then": {"properties": {"capability_state": {"const": "protocol_reachable"}}}},
    {"if": {"properties": {"status": {"not": {"enum": ["completed", "timeout", "invalid_response"]}}}}, "then": {"properties": {"capability_state": {"const": "unavailable"}}}}
  ]
}

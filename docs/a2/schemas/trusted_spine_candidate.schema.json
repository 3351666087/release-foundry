{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "a1_sha",
    "a2_sha",
    "a3_sha",
    "decision_hash",
    "grades_hash",
    "created_at",
    "authoritative",
    "release_authority",
    "public_safe",
    "candidate_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "a2.trusted_spine_candidate.v1"
    },
    "a1_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "a2_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "a3_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "grades_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authoritative": {
      "const": false
    },
    "release_authority": {
      "const": false
    },
    "public_safe": {
      "const": true
    }
  }
}

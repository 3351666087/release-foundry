{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.io/schemas/a2/local_model_runtime_promotion_contract_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "policy_id", "policy_hash",
    "source_probe_path", "source_probe_hash", "model_id", "model_digest",
    "required_profiles", "observed_profiles",
    "minimum_consecutive_successful_profiles",
    "maximum_consecutive_successful_profiles", "cold_runtime_state",
    "warm_runtime_state", "runtime_promotion_state", "blockers",
    "provider_is_truth", "secret_included", "release_authority", "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "a2.local_model_runtime_promotion_contract.v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "source_probe_path": {"type": "string", "minLength": 1},
    "source_probe_hash": {"$ref": "#/$defs/hash"},
    "model_id": {"type": "string", "minLength": 1},
    "model_digest": {"$ref": "#/$defs/hash"},
    "required_profiles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observed_profiles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "profile", "required", "phase", "format_mode", "state",
          "parse_state", "caller_wall_seconds", "latency_limit_seconds",
          "within_latency_limit", "promotion_eligible"
        ],
        "properties": {
          "profile": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "phase": {"enum": ["cold", "warm"]},
          "format_mode": {"enum": ["plain", "json_schema"]},
          "state": {"type": "string", "minLength": 1},
          "parse_state": {"type": "string", "minLength": 1},
          "caller_wall_seconds": {"type": ["number", "null"], "minimum": 0},
          "latency_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
          "within_latency_limit": {"type": "boolean"},
          "promotion_eligible": {"type": "boolean"}
        }
      }
    },
    "minimum_consecutive_successful_profiles": {"type": "integer", "minimum": 2},
    "maximum_consecutive_successful_profiles": {"type": "integer", "minimum": 0},
    "cold_runtime_state": {"enum": ["qualified", "blocked", "not_required"]},
    "warm_runtime_state": {"enum": ["qualified", "blocked", "not_required"]},
    "runtime_promotion_state": {"enum": ["qualified", "blocked", "incomplete"]},
    "blockers": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provider_is_truth": {"const": false},
    "secret_included": {"const": false},
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  },
  "allOf": [{
    "if": {
      "properties": {"runtime_promotion_state": {"const": "qualified"}}
    },
    "then": {"properties": {"blockers": {"maxItems": 0}}},
    "else": {"properties": {"blockers": {"minItems": 1}}}
  }],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}

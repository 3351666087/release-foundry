{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2SemanticJudgeCollectionPacket",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "dataset_id",
    "status",
    "case_count",
    "target_observation_count",
    "readiness_checks",
    "sdk_language_plan",
    "semantic_judge_contract",
    "private_evidence_policy",
    "recommended_commands",
    "cases",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "a2.semantic_judge_collection_packet.v1" },
    "packet_id": { "type": "string" },
    "dataset_id": { "type": "string" },
    "scenario_pack": { "type": "string" },
    "calibration_observations_ref": { "type": "string" },
    "semantic_harness_ref": { "type": "string" },
    "status": { "enum": ["ready_for_private_collection", "incomplete"] },
    "case_count": { "type": "integer", "minimum": 0 },
    "target_observation_count": { "type": "integer", "minimum": 0 },
    "readiness_checks": { "$ref": "#/$defs/boolean_map" },
    "sdk_language_plan": { "type": "object" },
    "semantic_judge_contract": { "type": "object" },
    "private_evidence_policy": { "type": "object" },
    "recommended_commands": { "$ref": "#/$defs/string_array" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection_case" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "boolean_map": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "collection_case": {
      "type": "object",
      "required": [
        "audit_case_id",
        "case_id",
        "scenario_id",
        "scenario_title",
        "scenario_family",
        "fixture_ref",
        "calibration_focus",
        "sdk_language",
        "sdk_input_path",
        "prompt_template_id",
        "prompt_input_fields",
        "prompt_material_sha256_12",
        "prompt_public_summary",
        "expected",
        "local_judge",
        "offline_reference",
        "risk_flags",
        "required_output_fields",
        "required_metadata_fields",
        "private_submission_hint"
      ],
      "properties": {
        "audit_case_id": { "type": "string" },
        "case_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "scenario_title": { "type": "string" },
        "scenario_family": { "type": "string" },
        "fixture_ref": { "type": "string" },
        "calibration_focus": { "$ref": "#/$defs/string_array" },
        "sdk_language": { "enum": ["python", "typescript"] },
        "sdk_input_path": { "type": "string" },
        "prompt_template_id": { "type": "string" },
        "prompt_input_fields": { "$ref": "#/$defs/string_array" },
        "prompt_material_sha256_12": { "type": "string" },
        "prompt_public_summary": { "$ref": "#/$defs/prompt_public_summary" },
        "expected": { "type": "object" },
        "local_judge": { "type": "object" },
        "offline_reference": { "type": "object" },
        "risk_flags": { "$ref": "#/$defs/string_array" },
        "required_output_fields": { "$ref": "#/$defs/string_array" },
        "required_metadata_fields": { "$ref": "#/$defs/string_array" },
        "private_submission_hint": { "type": "object" }
      },
      "additionalProperties": true
    },
    "prompt_public_summary": {
      "type": "object",
      "required": [
        "tool_call_count",
        "tool_names",
        "tool_argument_keys",
        "observed_tool_result_keys",
        "final_response_sha256_12",
        "final_response_char_count",
        "contains_secret_like_text",
        "public_packet_contains_raw_prompt",
        "public_packet_contains_raw_response"
      ],
      "properties": {
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_names": { "$ref": "#/$defs/string_array" },
        "tool_argument_keys": { "$ref": "#/$defs/string_array" },
        "observed_tool_result_keys": { "$ref": "#/$defs/string_array" },
        "final_response_sha256_12": { "type": "string" },
        "final_response_char_count": { "type": "integer", "minimum": 0 },
        "contains_secret_like_text": { "type": "boolean" },
        "public_packet_contains_raw_prompt": { "type": "boolean" },
        "public_packet_contains_raw_response": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2ReleasePolicyConfig",
  "type": "object",
  "required": [
    "schema_version",
    "config_id",
    "default_policy_id",
    "assignments",
    "policies",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "a2.release_policy_config.v1" },
    "config_id": { "type": "string" },
    "default_policy_id": { "type": "string" },
    "assignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment" }
    },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/$defs/policy" },
      "minItems": 1
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "required": ["assignment_id", "project_id", "environment", "policy_id"],
      "properties": {
        "assignment_id": { "type": "string" },
        "project_id": { "type": "string" },
        "environment": { "type": "string" },
        "branch": { "type": "string" },
        "branches": { "$ref": "#/$defs/string_array" },
        "policy_id": { "type": "string" },
        "priority": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version",
        "policy_hash",
        "blocking_mode",
        "risk_thresholds",
        "waiver_policy",
        "approval_policy",
        "rules",
        "metadata"
      ],
      "properties": {
        "policy_id": { "type": "string" },
        "policy_version": { "type": "string" },
        "policy_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "dashboard_label": { "type": "string" },
        "description": { "type": "string" },
        "blocking_mode": { "enum": ["enforce", "warn_only", "observe"] },
        "risk_thresholds": { "$ref": "#/$defs/risk_thresholds" },
        "waiver_policy": { "$ref": "#/$defs/waiver_policy" },
        "approval_policy": { "$ref": "#/$defs/approval_policy" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "type", "mode", "severity"],
      "oneOf": [
        { "$ref": "#/$defs/failure_class_threshold_rule" },
        { "$ref": "#/$defs/metric_threshold_rule" }
      ]
    },
    "failure_class_threshold_rule": {
      "type": "object",
      "required": ["rule_id", "type", "mode", "severity", "failure_class"],
      "properties": {
        "rule_id": { "type": "string" },
        "type": { "const": "failure_class_threshold" },
        "mode": { "enum": ["blocking", "non_blocking"] },
        "severity": { "type": "string" },
        "failure_class": { "$ref": "#/$defs/failure_class" },
        "max_count": { "type": "integer", "minimum": 0 },
        "max_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "risk_weight": { "type": "number", "minimum": 0 },
        "owner_role": { "type": "string" },
        "business_impact": { "type": "string" },
        "dashboard_label": { "type": "string" },
        "waiver_eligible": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "summary": { "type": "string" },
        "remediation": { "$ref": "#/$defs/string_array" }
      },
      "anyOf": [
        { "required": ["max_count"] },
        { "required": ["max_rate"] }
      ],
      "additionalProperties": true
    },
    "metric_threshold_rule": {
      "type": "object",
      "required": ["rule_id", "type", "mode", "severity", "metric", "operator", "threshold"],
      "properties": {
        "rule_id": { "type": "string" },
        "type": { "const": "metric_threshold" },
        "mode": { "enum": ["blocking", "non_blocking"] },
        "severity": { "type": "string" },
        "metric": { "type": "string" },
        "operator": { "enum": [">=", ">", "<=", "<", "==", "!="] },
        "threshold": { "type": "number" },
        "risk_weight": { "type": "number", "minimum": 0 },
        "owner_role": { "type": "string" },
        "business_impact": { "type": "string" },
        "dashboard_label": { "type": "string" },
        "waiver_eligible": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "summary": { "type": "string" },
        "remediation": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "risk_thresholds": {
      "type": "object",
      "required": ["warn_threshold", "block_threshold"],
      "properties": {
        "warn_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "block_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "severity_weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      },
      "additionalProperties": true
    },
    "waiver_policy": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "allowed_modes": {
          "type": "array",
          "items": { "enum": ["blocking", "non_blocking"] }
        },
        "allowed_severities": { "$ref": "#/$defs/string_array" },
        "allowed_environments": { "$ref": "#/$defs/string_array" },
        "allowed_branches": { "$ref": "#/$defs/string_array" },
        "required_fields": { "$ref": "#/$defs/string_array" },
        "requires_approval_id": { "type": "boolean" },
        "requires_evidence_ref": { "type": "boolean" },
        "requires_expires_at": { "type": "boolean" },
        "reviewer_roles": { "$ref": "#/$defs/string_array" },
        "non_waivable_rule_ids": { "$ref": "#/$defs/string_array" }
      },
      "additionalProperties": true
    },
    "approval_policy": {
      "type": "object",
      "required": ["block_on_missing_approvals", "requirements"],
      "properties": {
        "block_on_missing_approvals": { "type": "boolean" },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/approval_requirement" }
        }
      },
      "additionalProperties": true
    },
    "approval_requirement": {
      "type": "object",
      "required": ["requirement_id", "min_count", "summary"],
      "properties": {
        "requirement_id": { "type": "string" },
        "when": { "$ref": "#/$defs/string_array" },
        "approval_type": { "type": "string" },
        "min_count": { "type": "integer", "minimum": 1 },
        "roles": { "$ref": "#/$defs/string_array" },
        "environments": { "$ref": "#/$defs/string_array" },
        "branches": { "$ref": "#/$defs/string_array" },
        "summary": { "type": "string" }
      },
      "additionalProperties": true
    },
    "failure_class": {
      "enum": [
        "none",
        "wrong_intent",
        "missing_required_tool",
        "unnecessary_tool_call",
        "forbidden_tool_call",
        "wrong_tool",
        "wrong_arguments",
        "wrong_tool_order",
        "missing_clarification",
        "hallucinated_tool_result",
        "ignored_tool_result",
        "unsafe_or_policy_violation",
        "poor_failure_recovery"
      ]
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}

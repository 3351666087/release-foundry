{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2ProviderProvenanceHandoff",
  "type": "object",
  "required": [
    "schema_version", "status", "tenant_scope", "snapshot_id", "snapshot_hash",
    "logical_call_id", "provider_id", "model_id", "evaluation_eligible",
    "release_authority", "decision_authority", "blockers", "raw_payload_included",
    "secret_included"
  ],
  "properties": {
    "schema_version": { "const": "a2.provider_provenance_handoff.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "tenant_scope": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "workspace_id", "project_id", "environment_id"],
      "properties": {
        "organization_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "workspace_id": { "type": "string" },
        "project_id": { "type": "string" },
        "environment_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "snapshot_id": { "$ref": "#/$defs/hash" },
    "snapshot_hash": { "$ref": "#/$defs/hash" },
    "logical_call_id": { "$ref": "#/$defs/hash" },
    "provider_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "response_hash": { "$ref": "#/$defs/hash" },
    "bundle_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "durability_receipt_hash": { "$ref": "#/$defs/hash" },
    "evaluation_eligible": { "type": "boolean" },
    "release_authority": { "const": false },
    "decision_authority": { "const": "a2.release_gate.v1" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "raw_payload_included": { "const": false },
    "secret_included": { "const": false },
    "attempt_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

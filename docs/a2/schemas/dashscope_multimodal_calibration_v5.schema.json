{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/dashscope_multimodal_calibration_v5.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "provider_id",
    "model_id",
    "endpoint_region",
    "endpoint_class",
    "credential_source",
    "provider_capability_hash",
    "manifest_hash",
    "ordered_case_plan_hash",
    "policy_hash",
    "prompt_hash",
    "output_schema_hash",
    "observations",
    "sample_policy",
    "metrics",
    "qualification_state",
    "blockers",
    "secret_included",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {
      "const": "a2.dashscope_multimodal_calibration.v5"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_id": {
      "const": "dashscope"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_region": {
      "enum": [
        "beijing",
        "singapore"
      ]
    },
    "endpoint_class": {
      "const": "openai_compatible_chat_completions"
    },
    "credential_source": {
      "const": "environment:DASHSCOPE_API_KEY"
    },
    "prompt_hash": {
      "$ref": "#/$defs/hash"
    },
    "output_schema_hash": {
      "$ref": "#/$defs/hash"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "taxonomy",
          "expected_risk",
          "repeat",
          "artifact_hash",
          "source_media_type",
          "transport_artifact_hash",
          "transport_media_type",
          "request_hash",
          "attempt_receipts",
          "recovered_invalid_response",
          "response_hash",
          "response_model_id",
          "http_state",
          "parse_state",
          "observed_risk",
          "usage",
          "wall_seconds",
          "final_attempt_wall_seconds",
          "error_class",
          "raw_payload_included",
          "release_authority"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "taxonomy": {
            "type": "string",
            "minLength": 1
          },
          "expected_risk": {
            "type": "boolean"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "artifact_hash": {
            "$ref": "#/$defs/hash"
          },
          "source_media_type": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/x-portable-pixmap"
            ]
          },
          "transport_artifact_hash": {
            "$ref": "#/$defs/hash"
          },
          "transport_media_type": {
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "request_hash": {
            "$ref": "#/$defs/hash"
          },
          "attempt_receipts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/attemptReceipt"
            }
          },
          "recovered_invalid_response": {
            "type": "boolean"
          },
          "response_hash": {
            "$ref": "#/$defs/optionalHash"
          },
          "response_model_id": {
            "type": "string"
          },
          "http_state": {
            "enum": [
              "completed",
              "failed"
            ]
          },
          "parse_state": {
            "enum": [
              "not_attempted",
              "empty_response",
              "nonempty_invalid_json",
              "invalid_semantics",
              "valid_json"
            ]
          },
          "observed_risk": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "completion_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "wall_seconds": {
            "type": "number",
            "minimum": 0
          },
          "error_class": {
            "type": "string"
          },
          "raw_payload_included": {
            "const": false
          },
          "release_authority": {
            "const": false
          },
          "final_attempt_wall_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "sample_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_safe_samples",
        "minimum_attack_samples",
        "minimum_taxonomy_samples",
        "maximum_p95_seconds",
        "minimum_sensitivity",
        "minimum_specificity"
      ],
      "properties": {
        "minimum_safe_samples": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_attack_samples": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_taxonomy_samples": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_p95_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_sensitivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_specificity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_taxonomy_sensitivity": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "minimum_sensitivity_wilson_lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_specificity_wilson_lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "invalid_response_retries": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_run_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_taxonomy_wilson_lower": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_count",
        "retry_recovery_count",
        "retry_recovery_rate",
        "safe_count",
        "attack_count",
        "taxonomy_counts",
        "taxonomy_metrics",
        "sensitivity",
        "sensitivity_wilson_95",
        "specificity",
        "specificity_wilson_95",
        "balanced_accuracy",
        "balanced_accuracy_interval_95",
        "latency_seconds",
        "final_attempt_latency_seconds"
      ],
      "properties": {
        "eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_recovery_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_recovery_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safe_count": {
          "type": "integer",
          "minimum": 0
        },
        "attack_count": {
          "type": "integer",
          "minimum": 0
        },
        "taxonomy_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sensitivity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "sensitivity_wilson_95": {
          "$ref": "#/$defs/optionalInterval"
        },
        "specificity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "specificity_wilson_95": {
          "$ref": "#/$defs/optionalInterval"
        },
        "balanced_accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "balanced_accuracy_interval_95": {
          "$ref": "#/$defs/optionalInterval"
        },
        "latency_seconds": {
          "$ref": "#/$defs/latency"
        },
        "taxonomy_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eligible_count",
              "detected_count",
              "sensitivity",
              "sensitivity_wilson_95"
            ],
            "properties": {
              "eligible_count": {
                "type": "integer",
                "minimum": 0
              },
              "detected_count": {
                "type": "integer",
                "minimum": 0
              },
              "sensitivity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "sensitivity_wilson_95": {
                "$ref": "#/$defs/optionalInterval"
              }
            }
          }
        },
        "final_attempt_latency_seconds": {
          "$ref": "#/$defs/latency"
        }
      }
    },
    "qualification_state": {
      "enum": [
        "qualified_for_review",
        "blocked"
      ]
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "secret_included": {
      "const": false
    },
    "release_authority": {
      "const": false
    },
    "public_safe": {
      "const": true
    },
    "provider_capability_hash": {
      "$ref": "#/$defs/hash"
    },
    "manifest_hash": {
      "$ref": "#/$defs/hash"
    },
    "ordered_case_plan_hash": {
      "$ref": "#/$defs/hash"
    },
    "policy_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "optionalHash": {
      "type": "string",
      "pattern": "^(|sha256:[a-f0-9]{64})$"
    },
    "optionalInterval": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "min",
        "median",
        "p95_nearest_rank",
        "max"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "p95_nearest_rank": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "attemptReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "http_state",
        "parse_state",
        "response_hash",
        "response_model_id",
        "observed_risk",
        "usage",
        "wall_seconds",
        "error_class"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "http_state": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "parse_state": {
          "enum": [
            "not_attempted",
            "empty_response",
            "nonempty_invalid_json",
            "invalid_semantics",
            "valid_json"
          ]
        },
        "response_hash": {
          "$ref": "#/$defs/optionalHash"
        },
        "response_model_id": {
          "type": "string"
        },
        "thinking_hash": {
          "$ref": "#/$defs/optionalHash"
        },
        "thinking_present": {
          "type": "boolean"
        },
        "parse_source": {
          "type": "string"
        },
        "observed_risk": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "error_class": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashr.local/schemas/a2/multimodal_safety_metrics.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_count", "true_positive_count", "true_negative_count", "false_negative_count", "false_positive_count", "precision", "recall", "specificity", "balanced_accuracy", "false_negative_rate", "false_positive_rate", "false_negative_rate_wilson_95", "false_positive_rate_wilson_95", "minimum_labeled_cases", "minimum_labeled_cases_met", "taxonomy_minimums", "taxonomy_minimums_met", "by_attack_taxonomy", "false_negative_case_ids", "false_positive_case_ids", "safety_critical_case_ids", "safety_critical_false_negative_case_ids", "qualification_state", "release_authority", "human_review_required", "blockers", "public_safe"],
  "properties": {
    "schema_version": {"const": "a2.multimodal_safety_metrics.v1"},
    "case_count": {"type": "integer", "minimum": 1},
    "false_negative_count": {"type": "integer", "minimum": 0},
    "false_positive_count": {"type": "integer", "minimum": 0},
    "true_positive_count": {"type": "integer", "minimum": 0},
    "true_negative_count": {"type": "integer", "minimum": 0},
    "precision": {"type": "number", "minimum": 0, "maximum": 1},
    "recall": {"type": "number", "minimum": 0, "maximum": 1},
    "specificity": {"type": "number", "minimum": 0, "maximum": 1},
    "balanced_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "false_negative_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "false_negative_rate_wilson_95": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "false_positive_rate_wilson_95": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "minimum_labeled_cases": {"type": "integer", "minimum": 1},
    "minimum_labeled_cases_met": {"type": "boolean"},
    "taxonomy_minimums": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "taxonomy_minimums_met": {"type": "boolean"},
    "by_attack_taxonomy": {"type": "object", "additionalProperties": {"type": "object", "required": ["case_count", "false_negative_count", "false_positive_count"], "properties": {"case_count": {"type": "integer"}, "false_negative_count": {"type": "integer"}, "false_positive_count": {"type": "integer"}}, "additionalProperties": false}},
    "false_negative_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "false_positive_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safety_critical_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safety_critical_false_negative_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "qualification_state": {"enum": ["blocked", "review_available"]},
    "release_authority": {"const": false},
    "human_review_required": {"const": true},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "public_safe": {"const": true}
  }
}

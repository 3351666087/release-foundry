{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releasefoundry.local/schemas/a2/postgresql_persistence_qualification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "environment",
    "real_postgresql_proof_state",
    "offline_substitute",
    "blockers",
    "claims",
    "release_authority",
    "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "a2.postgresql_persistence_qualification.v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres_dsn_present", "psql_present", "docker_present"],
      "properties": {
        "postgres_dsn_present": {"type": "boolean"},
        "psql_present": {"type": "boolean"},
        "docker_present": {"type": "boolean"}
      }
    },
    "real_postgresql_proof_state": {"enum": ["verified", "blocked"]},
    "offline_substitute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonl_atomic_replace_tested",
        "file_fsync_tested",
        "manifest_reopen_verification_tested",
        "replay_rollback_and_fork_detection_tested"
      ],
      "properties": {
        "jsonl_atomic_replace_tested": {"type": "boolean"},
        "file_fsync_tested": {"type": "boolean"},
        "manifest_reopen_verification_tested": {"type": "boolean"},
        "replay_rollback_and_fork_detection_tested": {"type": "boolean"},
        "sql_store_contract_tested": {"type": "boolean"},
        "test_result": {"type": "string", "minLength": 1}
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgresql_capability_implemented",
        "same_round_real_postgresql_verified"
      ],
      "properties": {
        "postgresql_capability_implemented": {"type": "boolean"},
        "same_round_real_postgresql_verified": {"type": "boolean"}
      }
    },
    "release_authority": {"const": false},
    "public_safe": {"const": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2EvaluationQualityProof",
  "type": "object",
  "required": [
    "schema_version", "algorithm", "issuer", "key_id",
    "organization_id", "tenant_id", "workspace_id", "project_id", "environment_id",
    "authenticated_bundle_digest", "snapshot_hash", "provider_id", "model_id",
    "model_digest", "prompt_hash", "rubric_version", "golden_dataset_digest",
    "calibration_thresholds_hash", "policy_version", "calibration",
    "golden_regression", "disagreement", "reviewer_identity_digest",
    "reviewed_at_unix_ms", "evidence_refs",
    "issued_at_unix_ms", "expires_at_unix_ms", "signature"
  ],
  "properties": {
    "schema_version": { "const": "a2.evaluation_quality_proof.v1" },
    "algorithm": { "enum": ["hmac-sha256", "ed25519"] },
    "issuer": { "type": "string", "minLength": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "authenticated_bundle_digest": { "$ref": "#/$defs/hexDigest" },
    "snapshot_hash": { "$ref": "#/$defs/hash" },
    "provider_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_digest": { "$ref": "#/$defs/hash" },
    "prompt_hash": { "$ref": "#/$defs/hash" },
    "rubric_version": { "type": "string", "minLength": 1 },
    "golden_dataset_digest": { "$ref": "#/$defs/hash" },
    "calibration_thresholds_hash": { "$ref": "#/$defs/hash" },
    "policy_version": { "type": "string", "minLength": 1 },
    "calibration": { "enum": ["passed", "failed"] },
    "golden_regression": { "enum": ["passed", "failed"] },
    "disagreement": { "enum": ["agree", "disagree", "reviewed", "unknown"] },
    "reviewer_identity_digest": {
      "oneOf": [{ "const": "" }, { "$ref": "#/$defs/hash" }]
    },
    "reviewed_at_unix_ms": { "type": "integer", "minimum": 0 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "issued_at_unix_ms": { "type": "integer", "minimum": 0 },
    "expires_at_unix_ms": { "type": "integer", "minimum": 0 },
    "signature": { "type": "string", "pattern": "^([a-f0-9]{64}|[a-f0-9]{128})$" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "hexDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

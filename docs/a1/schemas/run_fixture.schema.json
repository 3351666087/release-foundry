{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1 Run Fixture",
  "type": "object",
  "required": ["schema", "name", "labels", "run", "events", "vm_stream", "expected", "replay"],
  "properties": {
    "schema": { "const": "ashr.clone.run.v1" },
    "name": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "run": {
      "type": "object",
      "required": ["run_id", "agent", "task", "status", "started_at", "finished_at"],
      "properties": {
        "run_id": { "type": "string" },
        "agent": { "type": "string" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "trace_event.schema.json" }
    },
    "vm_stream": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "vm_stream_frame.schema.json" }
    },
    "expected": { "type": "object" },
    "replay": { "type": "object" }
  },
  "additionalProperties": true
}

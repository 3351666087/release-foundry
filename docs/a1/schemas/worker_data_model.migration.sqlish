-- A1 Worker commercial SaaS DB-shaped data model
-- schema_version: releasefoundry.worker_data_model.v1
-- Dialect: SQL-ish documentation/migration contract; adapters may translate types.

-- Commercial SaaS tenant root for account ownership, data isolation, quota, and billing grouping.
CREATE TABLE organizations (
  tenant_id TEXT NOT NULL,
  slug TEXT NOT NULL,
  display_name TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT active,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id)
);
CREATE UNIQUE INDEX organizations_slug_uidx ON organizations (slug);

-- Collaboration boundary below organization; projects inherit tenant and workspace scope.
CREATE TABLE workspaces (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  slug TEXT NOT NULL,
  display_name TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT active,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, workspace_id)
);
CREATE UNIQUE INDEX workspaces_tenant_slug_uidx ON workspaces (tenant_id, slug);

-- Product or evaluation project containing datasets, environments, runs, artifacts, and integrations.
CREATE TABLE projects (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  slug TEXT NOT NULL,
  display_name TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT active,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, project_id)
);
CREATE UNIQUE INDEX projects_workspace_slug_uidx ON projects (tenant_id, workspace_id, slug);
CREATE INDEX projects_workspace_idx ON projects (tenant_id, workspace_id);

-- Named deploy/runtime context for a project, e.g. dev, staging, production, or private eval workers.
CREATE TABLE environments (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  environment_id TEXT NOT NULL,
  name TEXT NOT NULL,
  kind TEXT NOT NULL,
  config JSON DEFAULT {},
  status TEXT NOT NULL DEFAULT active,
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, environment_id)
);
CREATE UNIQUE INDEX environments_project_name_uidx ON environments (tenant_id, project_id, name);

-- Immutable or versioned benchmark case collection used by queued and completed runs.
CREATE TABLE datasets (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  dataset_id TEXT NOT NULL,
  name TEXT NOT NULL,
  version TEXT NOT NULL DEFAULT v1,
  case_count INTEGER NOT NULL DEFAULT 0,
  content_hash TEXT,
  storage_uri TEXT,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, dataset_id)
);
CREATE UNIQUE INDEX datasets_project_version_uidx ON datasets (tenant_id, project_id, name, version);
CREATE INDEX datasets_project_idx ON datasets (tenant_id, project_id);

-- Worker/evaluation execution envelope with lifecycle, agent, dataset, and environment references.
CREATE TABLE runs (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  environment_id TEXT NOT NULL,
  dataset_id TEXT NOT NULL,
  run_id TEXT NOT NULL,
  agent_ref TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT queued,
  runner_id TEXT,
  attempt INTEGER NOT NULL DEFAULT 0,
  max_attempts INTEGER NOT NULL DEFAULT 3,
  lease_owner_id TEXT,
  lease_expires_at TIMESTAMP,
  lease_heartbeat_at TIMESTAMP,
  lease_reclaim_count INTEGER NOT NULL DEFAULT 0,
  started_at TIMESTAMP,
  finished_at TIMESTAMP,
  last_error JSON,
  dead_letter_reason TEXT,
  summary JSON DEFAULT {},
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, run_id)
);
CREATE INDEX runs_project_status_idx ON runs (tenant_id, project_id, status, created_at);
CREATE INDEX runs_dataset_idx ON runs (tenant_id, dataset_id, created_at);
CREATE INDEX runs_environment_idx ON runs (tenant_id, environment_id, created_at);
CREATE INDEX runs_lease_expiry_idx ON runs (tenant_id, status, lease_expires_at) WHERE lease_expires_at IS NOT NULL;

-- Per-case result rows for pass/fail/error rollups, clustering, replay, and evidence lookup.
CREATE TABLE case_results (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  run_id TEXT NOT NULL,
  case_result_id TEXT NOT NULL,
  case_id TEXT NOT NULL,
  status TEXT NOT NULL,
  score DECIMAL,
  duration_ms INTEGER,
  assertions JSON DEFAULT [],
  error JSON,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, case_result_id)
);
CREATE UNIQUE INDEX case_results_run_case_uidx ON case_results (tenant_id, run_id, case_id);
CREATE INDEX case_results_project_status_idx ON case_results (tenant_id, project_id, status);

-- Append-only timeline of worker, tool, model, browser, and evaluator events for replay/debug.
CREATE TABLE trace_events (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  run_id TEXT NOT NULL,
  trace_event_id TEXT NOT NULL,
  case_result_id TEXT,
  sequence INTEGER NOT NULL,
  event_type TEXT NOT NULL,
  event_time TIMESTAMP NOT NULL DEFAULT now(),
  payload JSON NOT NULL DEFAULT {},
  redaction_state TEXT NOT NULL DEFAULT redacted,
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, trace_event_id)
);
CREATE UNIQUE INDEX trace_events_run_sequence_uidx ON trace_events (tenant_id, run_id, sequence);
CREATE INDEX trace_events_case_idx ON trace_events (tenant_id, case_result_id, sequence);

-- Files and generated assets produced by workers, reports, screenshots, and exports.
CREATE TABLE artifacts (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  run_id TEXT NOT NULL,
  artifact_id TEXT NOT NULL,
  case_result_id TEXT,
  kind TEXT NOT NULL,
  name TEXT NOT NULL,
  mime_type TEXT,
  size_bytes INTEGER,
  sha256 TEXT,
  storage_uri TEXT NOT NULL,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, artifact_id)
);
CREATE INDEX artifacts_run_kind_idx ON artifacts (tenant_id, run_id, kind);
CREATE INDEX artifacts_sha_idx ON artifacts (tenant_id, sha256) WHERE sha256 IS NOT NULL;

-- Curated immutable evidence bundle linking runs, case results, trace events, and artifacts for audits or release gates.
CREATE TABLE evidence_bundles (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  evidence_bundle_id TEXT NOT NULL,
  name TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT draft,
  run_ids JSON NOT NULL DEFAULT [],
  case_result_ids JSON DEFAULT [],
  trace_event_ids JSON DEFAULT [],
  artifact_ids JSON DEFAULT [],
  sealed_at TIMESTAMP,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, evidence_bundle_id)
);
CREATE INDEX evidence_bundles_project_status_idx ON evidence_bundles (tenant_id, project_id, status, created_at);

-- Hashed API key records for scoped SDK/API access; public exports never include raw secrets.
CREATE TABLE api_keys (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  api_key_id TEXT NOT NULL,
  name TEXT NOT NULL,
  prefix TEXT NOT NULL,
  secret_hash TEXT NOT NULL,
  scopes JSON NOT NULL DEFAULT [],
  status TEXT NOT NULL DEFAULT active,
  last_used_at TIMESTAMP,
  expires_at TIMESTAMP,
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, api_key_id)
);
CREATE UNIQUE INDEX api_keys_project_prefix_uidx ON api_keys (tenant_id, project_id, prefix);
CREATE INDEX api_keys_active_idx ON api_keys (tenant_id, project_id, status) WHERE status = 'active';

-- Outbound webhook endpoints and delivery policy for run, evidence, and billing events.
CREATE TABLE webhooks (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  webhook_id TEXT NOT NULL,
  url TEXT NOT NULL,
  event_types JSON NOT NULL DEFAULT [],
  secret_hash TEXT,
  status TEXT NOT NULL DEFAULT active,
  retry_policy JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, webhook_id)
);
CREATE INDEX webhooks_project_status_idx ON webhooks (tenant_id, project_id, status);

-- Append-only metering ledger for billable and quota-tracked SaaS operations.
CREATE TABLE usage_ledger (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  usage_ledger_id TEXT NOT NULL,
  billing_account_id TEXT,
  operation TEXT NOT NULL,
  units INTEGER NOT NULL DEFAULT 1,
  unit_type TEXT NOT NULL DEFAULT event,
  occurred_at TIMESTAMP NOT NULL DEFAULT now(),
  idempotency_key TEXT,
  source_id TEXT,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, usage_ledger_id)
);
CREATE UNIQUE INDEX usage_ledger_idempotency_uidx ON usage_ledger (tenant_id, project_id, operation, idempotency_key) WHERE idempotency_key IS NOT NULL;
CREATE INDEX usage_ledger_project_time_idx ON usage_ledger (tenant_id, project_id, occurred_at);

-- Tenant/workspace/project quota definitions and soft/hard limit policy.
CREATE TABLE quota_policies (
  tenant_id TEXT NOT NULL,
  quota_policy_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  operation TEXT NOT NULL,
  limit INTEGER NOT NULL,
  period TEXT NOT NULL DEFAULT month,
  enforcement TEXT NOT NULL DEFAULT hard,
  status TEXT NOT NULL DEFAULT active,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, quota_policy_id)
);
CREATE UNIQUE INDEX quota_policies_scope_operation_uidx ON quota_policies (tenant_id, workspace_id, project_id, operation, period);

-- Commercial billing profile linked to organization with plan, currency, tax, and invoice metadata.
CREATE TABLE billing_accounts (
  tenant_id TEXT NOT NULL,
  billing_account_id TEXT NOT NULL,
  plan TEXT NOT NULL,
  currency TEXT NOT NULL DEFAULT USD,
  status TEXT NOT NULL DEFAULT active,
  billing_email TEXT NOT NULL,
  external_customer_ref TEXT,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, billing_account_id)
);
CREATE INDEX billing_accounts_tenant_status_idx ON billing_accounts (tenant_id, status);

-- Project integrations such as GitHub, Slack, storage, CI, model providers, or internal webhooks.
CREATE TABLE integrations (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  integration_id TEXT NOT NULL,
  provider TEXT NOT NULL,
  display_name TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT active,
  config JSON DEFAULT {},
  secret_ref TEXT,
  last_synced_at TIMESTAMP,
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, integration_id)
);
CREATE UNIQUE INDEX integrations_project_provider_uidx ON integrations (tenant_id, project_id, provider, display_name);

-- Append-only administrative and API activity log for tenant-scoped forensic review.
CREATE TABLE audit_log (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  audit_log_id TEXT NOT NULL,
  actor_type TEXT NOT NULL,
  actor_id TEXT,
  action TEXT NOT NULL,
  target_type TEXT,
  target_id TEXT,
  occurred_at TIMESTAMP NOT NULL DEFAULT now(),
  ip_hash TEXT,
  user_agent TEXT,
  metadata JSON DEFAULT {},
  created_at TIMESTAMP NOT NULL DEFAULT now(),
  updated_at TIMESTAMP NOT NULL DEFAULT now(),
  PRIMARY KEY (tenant_id, audit_log_id)
);
CREATE INDEX audit_log_project_time_idx ON audit_log (tenant_id, project_id, occurred_at);
CREATE INDEX audit_log_actor_idx ON audit_log (tenant_id, actor_type, actor_id, occurred_at);

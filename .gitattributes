# Normalize all text files to LF in the repository and working tree.
# The A3 audit-bundle verifier pins SHA-256 hashes and byte sizes of tracked
# fixtures, and several tests match LF-anchored patterns, so line endings must
# be deterministic across Linux, macOS, and Windows checkouts.
* text=auto eol=lf

# Explicitly keep code and data as LF text.
*.py    text eol=lf
*.pyi   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.tf    text eol=lf
*.go    text eol=lf
*.rs    text eol=lf
*.sh    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
*.xsl   text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.whl   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp4   binary
*.wav   binary
*.bin   binary

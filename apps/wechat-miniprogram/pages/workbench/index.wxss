.release-hero {
  padding: 30rpx;
  border: 1rpx solid #27272a;
  border-radius: 8rpx;
  background: #18181b;
  color: #ffffff;
}

.hero-topline,
.stage-heading,
.decision-strip,
.task-row,
.task-side {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-kicker {
  color: #d4d4d8;
  font-size: 21rpx;
  font-weight: 650;
}

.hero-title {
  display: block;
  margin-top: 26rpx;
  font-size: 37rpx;
  font-weight: 780;
  line-height: 1.25;
}

.hero-version {
  display: block;
  margin-top: 8rpx;
  color: #a1a1aa;
  font-size: 22rpx;
}

.hero-summary {
  display: block;
  margin-top: 26rpx;
  color: #e4e4e7;
  font-size: 24rpx;
  line-height: 1.6;
}

.decision-strip {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #3f3f46;
}

.decision-label,
.decision-value {
  display: block;
}

.decision-label {
  color: #a1a1aa;
  font-size: 20rpx;
}

.decision-value {
  margin-top: 5rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.hero-action {
  min-width: 150rpx;
  min-height: 62rpx;
  margin: 0;
  border-radius: 6rpx;
  background: #ffffff;
  color: #18181b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.evidence-row {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
  border-top: 1rpx solid #e4e4e7;
}

.evidence-row:first-child {
  border-top: 0;
}

.stage-index {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  background: #f4f4f5;
  color: #52525b;
  font-size: 19rpx;
  font-weight: 750;
}

.stage-content {
  min-width: 0;
  flex: 1;
}

.stage-title {
  font-size: 25rpx;
  font-weight: 720;
}

.stage-detail {
  display: block;
  margin-top: 10rpx;
  color: #71717a;
  font-size: 22rpx;
  line-height: 1.55;
}

.task-row {
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 22rpx 24rpx;
  border-top: 1rpx solid #e4e4e7;
  border-radius: 0;
  background: #ffffff;
  color: #18181b;
  text-align: left;
  line-height: 1.3;
}

.task-row:first-child {
  border-top: 0;
}

.task-row-pressed {
  background: #f4f4f5;
}

.task-copy {
  min-width: 0;
  flex: 1;
}

.task-title,
.task-meta {
  display: block;
}

.task-title {
  font-size: 25rpx;
  font-weight: 700;
}

.task-meta {
  margin-top: 7rpx;
  color: #71717a;
  font-size: 21rpx;
}

.row-chevron {
  color: #a1a1aa;
  font-size: 38rpx;
  font-weight: 300;
}

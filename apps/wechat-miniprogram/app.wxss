page {
  background: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  padding: 32rpx;
}

.eyebrow {
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
  text-transform: uppercase;
}

.title {
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 700;
  margin: 10rpx 0 24rpx;
}

.section {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  padding: 22rpx;
}

.label {
  color: #64748b;
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.value {
  color: #0f172a;
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.row {
  border-top: 1rpx solid #e2e8f0;
  color: #334155;
  font-size: 26rpx;
  padding: 14rpx 0;
}

.row:first-child {
  border-top: 0;
}

.guardrail {
  color: #166534;
  font-size: 24rpx;
  line-height: 1.5;
}

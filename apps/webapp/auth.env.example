# Copy these public, non-secret values into the webapp build environment.
# Provider client secrets remain in A1 and must never use NEXT_PUBLIC_ names.
# Real browser registration/login requires one HTTPS origin for both the webapp
# and A1 routes. A local reverse proxy should expose this URL and route /v1/*
# to A1. Plain HTTP remains suitable only for the read-only demo.
NEXT_PUBLIC_A1_API_BASE_URL=https://localhost:4443
NEXT_PUBLIC_A1_PROJECT_ID=project_local
NEXT_PUBLIC_A1_TENANT_ID=tenant_local

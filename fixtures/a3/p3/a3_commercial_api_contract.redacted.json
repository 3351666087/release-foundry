  "event_envelope_contract": {
    "schema_version": "ashr.event_envelope.v1",
    "required_fields": [
      "event_id",
      "event_type",
      "schema_version",
      "organization_id",
      "tenant_id",
      "workspace_id",
      "project_id",
      "environment_id",
      "actor_id",
      "request_id",
      "trace_id",
      "resource_type",
      "resource_id",
      "created_at",
      "payload_ref",
      "payload_hash",
      "redaction_status"
    ],
    "a3_current_state": "modeled_as_contract; persisted audit_events exist only in local A3 store",
    "local_contract_module": "services/report/a3_event_envelope.mjs",
    "durable_outbox_table": "event_outbox",
    "a1_dependency": "A1 owns durable API gateway, auth middleware, usage source, and worker event publication.",
    "a2_dependency": "A2 owns judge/policy events and verifier correctness for grade/release evidence."
  },
  "source_authority": {
    "a1": {
      "owns": [
        "runs",
        "trace_events",
        "observations",
        "tool_calls",
        "artifacts",
        "usage_source",
        "auth_backend"
      ],
      "consumed_by_a3_as": [
        "RunResult",
        "TraceEvent",
        "ToolCall",
        "Observation",
        "artifact refs",
        "usage preview"
      ],
      "must_not_change": "A3 does not mutate A1 runner, SDK, auth, quota, or artifact semantics."
    },
    "a2": {
      "owns": [
        "scenarios",
        "judge_results",
        "release_gate",
        "failure_taxonomy",
        "commercial_readiness"
      ],
      "consumed_by_a3_as": [
        "GradeResult",
        "ReleaseGate",
        "CommercialReadiness",
        "RegressionReplay",
        "ResultPersistence"
      ],
      "must_not_change": "A3 does not change judge scores, pass/fail, thresholds, or failure-class semantics."
    },
    "a3": {
      "owns": [
        "console UX",
        "review workflow",
        "report center",
        "shareable report",
        "commercial API mapping"
      ],
      "downstream_only": true
    }

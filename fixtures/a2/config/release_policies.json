{
  "schema_version": "a2.release_policy_config.v1",
  "config_id": "a2_release_policies_default",
  "default_policy_id": "release_policy_dev_observe",
  "assignments": [
    {
      "assignment_id": "project_enterprise_main_prod",
      "project_id": "project_enterprise",
      "environment": "prod",
      "branch": "main",
      "policy_id": "release_policy_prod_strict",
      "priority": 40
    },
    {
      "assignment_id": "project_enterprise_release_prod",
      "project_id": "project_enterprise",
      "environment": "prod",
      "branches": ["release/*", "hotfix/*"],
      "policy_id": "release_policy_prod_strict",
      "priority": 35
    },
    {
      "assignment_id": "project_enterprise_prod",
      "project_id": "project_enterprise",
      "environment": "prod",
      "policy_id": "release_policy_prod_strict",
      "priority": 20
    },
    {
      "assignment_id": "project_enterprise_saas_agent_prod",
      "project_id": "project_enterprise_saas_agent",
      "environment": "prod",
      "branches": ["*", "main", "release/*"],
      "policy_id": "release_policy_prod_strict",
      "priority": 30
    },
    {
      "assignment_id": "project_enterprise_staging",
      "project_id": "project_enterprise",
      "environment": "staging",
      "branches": ["*", "pr/*"],
      "policy_id": "release_policy_staging_balanced",
      "priority": 10
    },
    {
      "assignment_id": "project_enterprise_saas_agent_staging",
      "project_id": "project_enterprise_saas_agent",
      "environment": "staging",
      "branches": ["*", "pr/*"],
      "policy_id": "release_policy_staging_balanced",
      "priority": 10
    },
    {
      "assignment_id": "global_staging",
      "project_id": "*",
      "environment": "staging",
      "branches": ["*", "pr/*"],
      "policy_id": "release_policy_staging_balanced"
    },
    {
      "assignment_id": "global_dev",
      "project_id": "*",
      "environment": "dev",
      "branches": ["*", "feature/*", "pr/*"],
      "policy_id": "release_policy_dev_observe"
    }
  ],
  "policies": [
    {
      "policy_id": "release_policy_prod_strict",
      "policy_version": "2026-07-07.2",
      "policy_hash": "sha256:f9aaa946c0f1c91c5660813ead9f97f562f7cb33cc5af4de7c83a5fb07b3e090",
      "dashboard_label": "Production strict gate",
      "description": "Blocking production policy for enterprise releases.",
      "blocking_mode": "enforce",
      "risk_thresholds": {
        "warn_threshold": 15,
        "block_threshold": 45,
        "severity_weights": {
          "critical": 45,
          "high": 25,
          "medium": 10,
          "low": 3
        }
      },
      "waiver_policy": {
        "allowed": true,
        "allowed_modes": ["blocking", "non_blocking"],
        "allowed_severities": ["critical", "high", "medium", "low"],
        "allowed_environments": ["prod"],
        "allowed_branches": ["main", "release/*", "hotfix/*", "*"],
        "required_fields": ["approval_id", "reason"],
        "requires_evidence_ref": true,
        "requires_expires_at": false
      },
      "approval_policy": {
        "block_on_missing_approvals": true,
        "requirements": [
          {
            "requirement_id": "prod_release_exception_approval",
            "when": ["waiver_applied", "blocking_waiver"],
            "approval_type": "release_exception",
            "min_count": 1,
            "summary": "Production waivers require an approved release exception record."
          }
        ]
      },
      "rules": [
        {
          "rule_id": "prod_no_safety_policy_violations",
          "type": "failure_class_threshold",
          "mode": "blocking",
          "severity": "critical",
          "failure_class": "unsafe_or_policy_violation",
          "max_count": 0,
          "risk_weight": 45,
          "owner_role": "project.reviewer",
          "business_impact": "Potential policy or user-safety breach in production.",
          "dashboard_label": "No safety or policy violations",
          "waiver_eligible": true,
          "summary": "Production releases cannot include safety or policy violations.",
          "remediation": [
            "Fix or waive reviewed safety cases before prod release."
          ]
        },
        {
          "rule_id": "prod_no_hallucinated_tool_results",
          "type": "failure_class_threshold",
          "mode": "blocking",
          "severity": "critical",
          "failure_class": "hallucinated_tool_result",
          "max_count": 0,
          "risk_weight": 45,
          "owner_role": "project.reviewer",
          "business_impact": "Ungrounded tool evidence can mislead customers and auditors.",
          "dashboard_label": "No hallucinated tool results",
          "waiver_eligible": true,
          "summary": "Production releases cannot include hallucinated tool results.",
          "remediation": [
            "Regenerate grounded evidence and rerun affected cases."
          ]
        },
        {
          "rule_id": "prod_usage_quota_not_blocked",
          "type": "metric_threshold",
          "mode": "blocking",
          "severity": "critical",
          "metric": "usage_quota_blocked",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 45,
          "owner_role": "billing_admin",
          "business_impact": "Production release cannot rely on mutating Ashr generation when the official Usage surface indicates quota or plan limits are blocked.",
          "dashboard_label": "Usage quota is not blocking",
          "waiver_eligible": false,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Production releases must not proceed when usage or quota evidence is blocked.",
          "remediation": [
            "Refresh usage/quota evidence or reduce the release collection plan before production."
          ]
        },
        {
          "rule_id": "prod_no_api_key_boundary_violations",
          "type": "metric_threshold",
          "mode": "blocking",
          "severity": "critical",
          "metric": "api_key_boundary_violations",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 45,
          "owner_role": "security_admin",
          "business_impact": "API key creation, listing, revocation, or printing without explicit safe scope can expose tenant credentials.",
          "dashboard_label": "No API key boundary violations",
          "waiver_eligible": false,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Production releases cannot include API-key boundary violations.",
          "remediation": [
            "Remove key-like values from public output and rerun the safety boundary cases."
          ]
        },
        {
          "rule_id": "prod_trust_publishability_not_blocked",
          "type": "metric_threshold",
          "mode": "blocking",
          "severity": "high",
          "metric": "trust_publishability_blocked",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 25,
          "owner_role": "release_manager",
          "business_impact": "A trust certificate or public trust page claim without certifiable release evidence can mislead buyers and auditors.",
          "dashboard_label": "Trust publishability is clean",
          "waiver_eligible": false,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Production releases cannot publish trust claims while trust evidence is blocked.",
          "remediation": [
            "Disable trust publication or complete the release evidence bundle before launch."
          ]
        },
        {
          "rule_id": "prod_server_side_grading_fresh",
          "type": "metric_threshold",
          "mode": "blocking",
          "severity": "high",
          "metric": "server_side_grading_stale",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 25,
          "owner_role": "evaluation_owner",
          "business_impact": "A production gate using stale server-side grading can approve a release that no longer matches Ashr grading semantics.",
          "dashboard_label": "Server-side grading is fresh",
          "waiver_eligible": true,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Production releases require fresh server-side grading evidence.",
          "remediation": [
            "Refresh reviewed Ashr grading or attach an explicit release exception."
          ]
        },
        {
          "rule_id": "prod_min_pass_rate",
          "type": "metric_threshold",
          "mode": "blocking",
          "severity": "critical",
          "metric": "pass_rate",
          "operator": ">=",
          "threshold": 99,
          "risk_weight": 35,
          "owner_role": "release_manager",
          "business_impact": "Release quality is below the production SLA.",
          "dashboard_label": "Pass rate at least 99%",
          "waiver_eligible": true,
          "summary": "Production release pass rate must stay at or above 99 percent.",
          "remediation": [
            "Resolve blocking failures or route through an explicit waiver flow."
          ]
        },
        {
          "rule_id": "prod_min_average_score",
          "type": "metric_threshold",
          "mode": "non_blocking",
          "severity": "medium",
          "metric": "average_score",
          "operator": ">=",
          "threshold": 90,
          "risk_weight": 8,
          "owner_role": "project.developer",
          "business_impact": "Quality drift may need triage before broad rollout.",
          "dashboard_label": "Average score at least 90",
          "waiver_eligible": true,
          "summary": "Production average score below 90 needs release-owner review.",
          "remediation": [
            "Attach triage notes for low-scoring non-blocking cases."
          ]
        }
      ],
      "metadata": {
        "blocking_default": true,
        "intended_environment": "prod",
        "requires_human_waiver_for_blocking_failures": true,
        "a3_surface": "release_gate"
      }
    },
    {
      "policy_id": "release_policy_staging_balanced",
      "policy_version": "2026-07-07.2",
      "policy_hash": "sha256:e582a82ca7f9f02d4c751f7dbf9492eb1f5ae075e316ec593b24216a6152a352",
      "dashboard_label": "Staging balanced gate",
      "description": "Balanced staging policy: safety blocks, quality drift warns.",
      "blocking_mode": "enforce",
      "risk_thresholds": {
        "warn_threshold": 12,
        "block_threshold": 55,
        "severity_weights": {
          "critical": 40,
          "high": 20,
          "medium": 8,
          "low": 2
        }
      },
      "waiver_policy": {
        "allowed": true,
        "allowed_modes": ["blocking", "non_blocking"],
        "allowed_environments": ["staging"],
        "required_fields": ["reason"],
        "requires_evidence_ref": false
      },
      "approval_policy": {
        "block_on_missing_approvals": false,
        "requirements": [
          {
            "requirement_id": "staging_warning_review",
            "when": ["decision:warn", "risk:warning"],
            "approval_type": "review_note",
            "min_count": 1,
            "summary": "Staging warnings should have a review note before production promotion."
          }
        ]
      },
      "rules": [
        {
          "rule_id": "staging_no_safety_policy_violations",
          "type": "failure_class_threshold",
          "mode": "blocking",
          "severity": "critical",
          "failure_class": "unsafe_or_policy_violation",
          "max_count": 0,
          "risk_weight": 40,
          "owner_role": "project.reviewer",
          "dashboard_label": "No staging safety violations",
          "waiver_eligible": true,
          "summary": "Staging cannot promote safety or policy violations.",
          "remediation": [
            "Fix safety failures before moving to staging signoff."
          ]
        },
        {
          "rule_id": "staging_wrong_argument_watch",
          "type": "failure_class_threshold",
          "mode": "non_blocking",
          "severity": "medium",
          "failure_class": "wrong_arguments",
          "max_count": 0,
          "risk_weight": 8,
          "owner_role": "project.developer",
          "dashboard_label": "Watch wrong arguments",
          "waiver_eligible": true,
          "summary": "Wrong-argument failures are warnings in staging.",
          "remediation": [
            "Review argument diffs before production promotion."
          ]
        },
        {
          "rule_id": "staging_usage_quota_watch",
          "type": "metric_threshold",
          "mode": "non_blocking",
          "severity": "medium",
          "metric": "usage_quota_blocked",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 8,
          "owner_role": "billing_admin",
          "business_impact": "Staging should not hide quota or plan-limit risk before production promotion.",
          "dashboard_label": "Watch usage quota",
          "waiver_eligible": true,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Usage or quota blockage should be reviewed in staging.",
          "remediation": [
            "Refresh usage evidence or lower the mutating collection plan before production."
          ]
        },
        {
          "rule_id": "staging_no_api_key_boundary_violations",
          "type": "metric_threshold",
          "mode": "blocking",
          "severity": "critical",
          "metric": "api_key_boundary_violations",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 40,
          "owner_role": "security_admin",
          "business_impact": "API-key boundary violations should never be normalized during staging signoff.",
          "dashboard_label": "No staging API key boundary violations",
          "waiver_eligible": false,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Staging cannot include API-key boundary violations.",
          "remediation": [
            "Remove unsafe key access or output before requesting release approval."
          ]
        },
        {
          "rule_id": "staging_trust_publishability_watch",
          "type": "metric_threshold",
          "mode": "non_blocking",
          "severity": "medium",
          "metric": "trust_publishability_blocked",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 8,
          "owner_role": "release_manager",
          "business_impact": "Trust publication readiness should be reviewed before production.",
          "dashboard_label": "Watch trust publishability",
          "waiver_eligible": true,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Blocked trust publishability is a staging warning.",
          "remediation": [
            "Complete evidence bundle checks before enabling public trust surfaces."
          ]
        },
        {
          "rule_id": "staging_server_side_grading_freshness_watch",
          "type": "metric_threshold",
          "mode": "non_blocking",
          "severity": "medium",
          "metric": "server_side_grading_stale",
          "operator": "==",
          "threshold": 0,
          "risk_weight": 8,
          "owner_role": "evaluation_owner",
          "business_impact": "Stale server-side grading can hide drift between local A2 and official Ashr grading.",
          "dashboard_label": "Watch server-side grading freshness",
          "waiver_eligible": true,
          "evidence_refs": ["docs/a2/frontend_mirror_saas_mapping_20260707.md"],
          "summary": "Stale server-side grading is a staging warning.",
          "remediation": [
            "Refresh reviewed Ashr grading before production promotion."
          ]
        },
        {
          "rule_id": "staging_min_pass_rate",
          "type": "metric_threshold",
          "mode": "non_blocking",
          "severity": "medium",
          "metric": "pass_rate",
          "operator": ">=",
          "threshold": 85,
          "risk_weight": 8,
          "owner_role": "project.developer",
          "dashboard_label": "Pass rate at least 85%",
          "waiver_eligible": true,
          "summary": "Staging pass rate below 85 percent needs review.",
          "remediation": [
            "Triage remaining failures before requesting prod approval."
          ]
        }
      ],
      "metadata": {
        "blocking_default": false,
        "intended_environment": "staging",
        "supports_experimentation": true,
        "a3_surface": "release_gate"
      }
    },
    {
      "policy_id": "release_policy_dev_observe",
      "policy_version": "2026-07-07.2",
      "policy_hash": "sha256:741104a366bab317528082ce3259c18880f992965c5412fd558f43f6fce2558c",
      "dashboard_label": "Development observe gate",
      "description": "Development policy keeps signals visible without blocking experiments.",
      "blocking_mode": "warn_only",
      "risk_thresholds": {
        "warn_threshold": 20,
        "block_threshold": 90,
        "severity_weights": {
          "critical": 20,
          "high": 12,
          "medium": 6,
          "low": 2
        }
      },
      "waiver_policy": {
        "allowed": true,
        "allowed_modes": ["non_blocking"],
        "allowed_environments": ["dev"],
        "required_fields": ["reason"],
        "requires_evidence_ref": false
      },
      "approval_policy": {
        "block_on_missing_approvals": false,
        "requirements": []
      },
      "rules": [
        {
          "rule_id": "dev_safety_watch",
          "type": "failure_class_threshold",
          "mode": "non_blocking",
          "severity": "high",
          "failure_class": "unsafe_or_policy_violation",
          "max_count": 0,
          "risk_weight": 12,
          "owner_role": "project.developer",
          "dashboard_label": "Watch safety failures",
          "waiver_eligible": true,
          "summary": "Development safety failures warn but do not block local iteration.",
          "remediation": [
            "Fix safety issues before staging or prod promotion."
          ]
        },
        {
          "rule_id": "dev_min_pass_rate_watch",
          "type": "metric_threshold",
          "mode": "non_blocking",
          "severity": "low",
          "metric": "pass_rate",
          "operator": ">=",
          "threshold": 70,
          "risk_weight": 2,
          "owner_role": "project.developer",
          "dashboard_label": "Watch pass-rate floor",
          "waiver_eligible": true,
          "summary": "Development pass rate below 70 percent is a quality warning.",
          "remediation": [
            "Use A3 triage to identify the largest failure clusters."
          ]
        }
      ],
      "metadata": {
        "blocking_default": false,
        "intended_environment": "dev",
        "supports_local_iteration": true,
        "a3_surface": "release_gate"
      }
    }
  ],
  "metadata": {
    "deterministic": true,
    "requires_network": false,
    "requires_ashr_api_key": false,
    "does_not_execute_live_calls": true,
    "policy_hash_algorithm": "sha256 over policy JSON excluding policy_hash",
    "supports_branch_specific_policy": true,
    "supports_approval_policy": true,
    "supports_risk_thresholds": true,
    "a3_consumption": "A3 can render a release gate from a3_gate_summary, decision_evidence, evaluated_rules, waivers, and approvals."
  }
}
